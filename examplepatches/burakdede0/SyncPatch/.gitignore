# Android target APK used for local validation — do not upload (72 MB proprietary app binary)
sync.apk

# Build outputs
build/
*/build/
.gradle/
.kotlin/
.gradletaskdefinitioncache/

# IDE / OS noise
.idea/
.vscode/
.DS_Store
*.iml

# Local validator write-out
validator/build/patched-dex/

# Validator resource output (only written with -Dvalidate.resources) — test artifact,
