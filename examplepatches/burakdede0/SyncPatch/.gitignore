patched-resources.apk

# Bundle outputs — publish as GitHub release assets, never in git
patches.mpp
*.mpp

# NOTE: the generated extension DEX resources are COMMITTED
# (patches/src/main/resources/extensions/titlefont.mpe and predictiveback.mpe)
# so that CI can bundle them into the patches release. Rebuild them locally
# with ./build_ext.sh and commit the updated files.

