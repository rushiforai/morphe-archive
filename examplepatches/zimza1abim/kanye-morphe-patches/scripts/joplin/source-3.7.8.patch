@@ -0,0 +1,109 @@
+/* Morphe font runtime. No device paths are embedded in the release bundle. */
+const React = require('react');
+const RN = require('react-native');
+const FSModule = require('@dr.pogodin/react-native-fs');
+const FS = FSModule.default || FSModule;
+const listeners = new Set();
+let state = Object.freeze({ ready: false, enabled: false, revision: 0 });
+let pending;
+const FontContext = React.createContext(undefined);
+const wrappers = new WeakMap();
+
+function ordinaryFamily(family) {
+    return family == null || family === '' || /^JoplinCustomFont_[0-9]+$/.test(family)
+        || /^(Roboto(?: (?:Light|Medium|Thin|Condensed))?|sans-serif(?:-(?:light|medium|thin|condensed))?|serif|monospace|System|system-ui|Arial|Helvetica|Courier New|Menlo|Avenir)$/i.test(family);
+}
+function subscribe(callback) { listeners.add(callback); return () => listeners.delete(callback); }
+function useFont() { return React.useSyncExternalStore(subscribe, () => state, () => state); }
+async function refresh() {
+    if (pending) return pending;
+    pending = (async () => {
+        let next = { ready: true, enabled: false, revision: 0 };
+        let timer;
+        try {
+            next = await Promise.race([(async () => {
+                const next = { ready: true, enabled: false, revision: 0 };
+            const dir = FS.DocumentDirectoryPath + '/joplin-custom-font/';
+            if (await FS.exists(dir + 'state.json')) {
+                const data = JSON.parse(await FS.readFile(dir + 'state.json', 'utf8'));
+                if (!Number.isSafeInteger(data.revision)) throw Error('Invalid font revision');
+                next.revision = data.revision;
+                next.name = data.name;
+                if (data.enabled) {
+                    if (!data.fontPath || !data.fontPath.startsWith(dir)
+                        || !/^font-[0-9]+\.ttf$/.test(data.fontPath.slice(dir.length)))
+                        throw Error('Invalid font path');
+                    if (!await FS.exists(data.fontPath)) throw Error('Font file missing');
+                    next.enabled = true;
+                    next.fontUrl = 'https://morphe-font.invalid/' + data.fontPath.slice(dir.length);
+                    next.family = 'JoplinCustomFont_' + data.revision;
+                }
+            }
+                return next;
+            })(), new Promise((_, reject) => { timer = setTimeout(() => reject(Error('Font state read timed out')), 3000); })]);
+        } catch (error) { console.warn('JoplinFontPatch: font state unavailable', String(error)); }
+        finally { clearTimeout(timer); }
+        if (!state.ready || state.revision !== next.revision || state.enabled !== next.enabled) {
+            state = Object.freeze(next);
+            console.info('JoplinFontPatch v10: state ready, enabled=' + next.enabled + ', revision=' + next.revision);
+            listeners.forEach(fn => fn());
+        }
+    })().finally(() => { pending = null; });
+    return pending;
+}
+
+function wrapText(Component) {
+    if (wrappers.has(Component)) return wrappers.get(Component);
+    const Wrapped = React.forwardRef((props, ref) => {
+        const font = useFont();
+        const inheritedFamily = React.useContext(FontContext);
+        const flat = RN.StyleSheet.flatten(props.style) || {};
+        const family = flat.fontFamily == null ? inheritedFamily : flat.fontFamily;
+        const style = React.useMemo(() => font.enabled && ordinaryFamily(family)
+            ? [props.style, { fontFamily: font.family }] : props.style,
+            [props.style, font.enabled, font.family, family]);
+        return React.createElement(FontContext.Provider, { value: family },
+            React.createElement(Component, { ...props, ref, style }));
+    });
+    // Keep TextInput.State and its other public static APIs, not forwardRef internals.
+    for (const key of Object.keys(Component)) {
+        if (!['$$typeof', 'render', 'displayName', 'propTypes'].includes(key)) Wrapped[key] = Component[key];
+    }
+    Wrapped.displayName = 'MorpheFontText';
+    wrappers.set(Component, Wrapped);
+    return Wrapped;
+}
+function FontReady({ children }) { return useFont().ready ? children : null; }
+
+function prepareHtml(html, font) {
+    if (!font.enabled || !html || html.includes('id="morphe-font-style"')) return html;
+    const family = font.family;
+    const url = font.fontUrl.replace(/["\\\r\n]/g, c => '\\' + c);
+    const textSelector = 'body,p,h1,h2,h3,h4,h5,h6,li,td,th,blockquote,a,b,strong,em,code,pre,kbd,samp,'
+        + 'input,textarea,.cm-editor,.cm-content,.cm-line,.cm-scroller,.CodeMirror,.CodeMirror-line,'
+        + '#rendered-md,.markdown-body,.exported-note';
+    const protectedSelector = textSelector.split(',').map(s => s + ':not([class*="icon"]):not([class*="fa-"]):not(.fa)').join(',');
+    const css = '@font-face{font-family:"' + family + '";src:url("' + url + '");font-display:block;}'
+        + 'html[data-morphe-font-pending] body{visibility:hidden!important;}'
+        + protectedSelector + '{font-family:"' + family + '",sans-serif!important;}';
+    const script = '(function(){var root=document.documentElement;root.setAttribute("data-morphe-font-pending","");'
+        + 'var done=false;var finish=function(ok){if(done)return;done=true;clearTimeout(timer);'
+        + 'if(!ok){var s=document.getElementById("morphe-font-style");if(s)s.remove();'
+        + 'console.warn("JoplinFontPatch: font load failed or timed out; default retained");}'
+        + 'root.removeAttribute("data-morphe-font-pending");};'
+        + 'var timer=setTimeout(function(){finish(false);},4000);'
+        + 'try{document.fonts.load(' + JSON.stringify('16px "' + family + '"') + ',"한글ABC").then(function(f){finish(f.length>0);},function(){finish(false);});}'
+        + 'catch(e){finish(false);}})();';
+    const injection = '<style id="morphe-font-style">' + css + '</style><script>' + script + '</script>';
+    const head = /<head(?:\s[^>]*)?>/i.exec(html);
+    if (!head) return injection + html;
+    const at = head.index + head[0].length;
+    return html.slice(0, at) + injection + html.slice(at);
+}
+if (RN.Platform.OS === 'android') {
+    RN.AppState.addEventListener('change', status => { if (status === 'active') void refresh(); });
+    void refresh();
+} else {
+    state = Object.freeze({ ready: true, enabled: false, revision: 0 });
+}
+module.exports = { useFont, refresh, wrapText, FontReady, prepareHtml, ordinaryFamily };
