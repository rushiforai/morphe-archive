<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawn for Morphe in the style of Ionicons
    (https://github.com/ionic-team/ionicons/tree/d1e2c48641fd5f4910ee42a144dc1c84b1a9a4ee).
    Not an Ionicons glyph: the small window is outlined to match the Ionicons player icons.
    Written by lavinhoque33, 2026-10-25.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="512"
            android:viewportHeight="512">
            <group
                android:name="icon_group"
                android:pivotX="256"
                android:pivotY="256">
                <path
                    android:strokeColor="@android:color/white"
                    android:strokeWidth="32"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:pathData="M120,112 L392,112 A56,56 0 0 1 448,168 L448,344 A56,56 0 0 1 392,400 L120,400 A56,56 0 0 1 64,344 L64,168 A56,56 0 0 1 120,112 Z" />
                <path
                    android:strokeColor="@android:color/white"
                    android:strokeWidth="32"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:pathData="M260,232 L364,232 A28,28 0 0 1 392,260 L392,316 A28,28 0 0 1 364,344 L260,344 A28,28 0 0 1 232,316 L232,260 A28,28 0 0 1 260,232 Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="icon_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="250"
                    android:valueFrom="0.8"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="250"
                    android:valueFrom="0.8"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
