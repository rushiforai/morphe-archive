# Morphe environment configuration
# Copy this to .env and fill in values

# GitHub Personal Access Token
# Required scopes: read:packages
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub username for package registry auth
GITHUB_USER=

# Path to morphe-cli.jar (morphe-desktop all-in-one JAR)
# Download from: https://github.com/MorpheApp/morphe-desktop/releases
MORPHE_CLI=./morphe-cli.jar

# Keystore settings (for APK signing)
KEYSTORE_PATH=./Morphe.keystore
KEYSTORE_ALIAS=Morphe
KEYSTORE_PASS=
KEY_PASS=Morphe

# ADB device serial (leave empty for default device)
ADB_DEVICE=

# Optional: Kaggle API key for remote decompilation
# KAGGLE_API_TOKEN=
# KAGGLE_KERNEL_ID=
