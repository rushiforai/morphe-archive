@@ -0,0 +1,18 @@
+// Stubs for disassembler/IL-printer symbols that a non-PRODUCT Dart VM library references.
+// Blutter never calls them; they exist only so non-product (release-mode) snapshots can link.
+#include "pch.h"
+#include <vm/compiler/assembler/disassembler.h>
+#include <vm/compiler/api/print_filter.h>
+
+namespace dart {
+void DisassembleToStdout::ConsumeInstruction(char*, intptr_t, char*, intptr_t, Object*, uword) {}
+void DisassembleToStdout::Print(const char*, ...) {}
+void DisassembleToJSONStream::ConsumeInstruction(char*, intptr_t, char*, intptr_t, Object*, uword) {}
+void DisassembleToJSONStream::Print(const char*, ...) {}
+void Disassembler::Disassemble(uword, uword, DisassemblyFormatter*, const Code&, const CodeComments*) {}
+void Disassembler::DisassembleCode(const Function&, const Code&, bool) {}
+void Disassembler::DisassembleStub(const char*, const Code&) {}
+namespace compiler {
+bool PrintFilter::ShouldPrint(const Function&, uint8_t**) { return false; }
+}  // namespace compiler
+}  // namespace dart
