<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center"
    android:background="@drawable/corner_dialog"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="0.0dip"
    android:layout_marginStart="7.0dip"
    android:layout_marginEnd="7.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/adjson_header_image"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5.0dip"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@string/header_image" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/adjson_ad_asset_holder"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10.0dip"
        android:layout_below="@id/adjson_header_image">
        <ImageView
            android:id="@id/adjson_app_icon"
            android:layout_width="70.0dip"
            android:layout_height="70.0dip"
            android:layout_margin="10.0dip" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10.0dip">
            <TextView
                android:textSize="17.0sp"
                android:textStyle="bold"
                android:id="@id/adjson_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:textSize="14.0sp"
                android:id="@id/adjson_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip">
                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@id/adjson_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:rating="5.0"
                    android:stepSize="0.1"
                    android:isIndicator="true"
                    android:progressTint="@color/colorButtonPrimary"
                    style="@style/Widget.AppCompat.RatingBar.Small" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip">
                <TextView
                    android:textSize="14.0sp"
                    android:id="@id/adjson_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="12.0sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@id/adjson_cta"
        android:background="@drawable/corner_button"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginRight="20.0dip"
        android:layout_marginBottom="10.0dip"
        android:layout_below="@id/adjson_ad_asset_holder"
        android:contentDescription="@string/app_name" />
    <ImageButton
        android:id="@id/button_close"
        android:background="@drawable/close_ad"
        android:layout_width="25.0dip"
        android:layout_height="25.0dip"
        android:src="@drawable/close"
        android:scaleType="fitEnd"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/close_button"
        android:layout_alignParentEnd="true" />
</RelativeLayout>