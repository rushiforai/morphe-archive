<?xml version="1.0" encoding="utf-8"?>
<!--
  An extension is code merged into Apple Music: this manifest is never installed. The components
  the bundled libraries declare would only keep their classes under their own names, the names
  Apple Music's own copies use, so they are removed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application tools:remove="android:appComponentFactory">
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
