.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/
*.swp
*~

# Local Secrets & Environment Properties
local.properties
.env
.env.*
*.keystore
*.jks

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
