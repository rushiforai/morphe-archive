{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "type": "feat",
            "scope": "nicolive-v2",
            "release": "major"
          },
          {
            "type": "feat",
            "subject": "prepare v1.10.4-dev.1 controls and incremental comment updates",
            "release": "patch"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "feat",
            "scope": "dev",
            "release": "patch"
          },
          {
            "type": "bump",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "build",
            "scope": "Needs bump",
            "release": "patch"
          },
          {
            "type": "feat",
            "scope": "download",
            "release": "patch"
          },
          {
            "type": "feat",
            "scope": "mp3",
            "release": "patch"
          },
          {
            "type": "feat",
            "scope": "issue132",
            "release": "patch"
          },
          {
            "type": "feat",
            "scope": "settings",
            "release": "patch"
          },
          {
            "type": "feat",
            "scope": "media",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "./.github/scripts/release-notes.cjs",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "fix",
              "section": "🐛 Bug Fixes",
              "effect": "bump"
            },
            {
              "type": "feat",
              "section": "✨ New Features",
              "effect": "bump"
            },
            {
              "type": "bump",
              "section": "🚀 Updated App Support",
              "effect": "bump"
            },
            {
              "type": "perf",
              "section": "🔧 Improvements",
              "effect": "bump"
            },
            {
              "type": "build",
              "effect": "hidden"
            }
          ]
        }
      }
    ],
    [
      "@MorpheApp/changelog",
      {
        "releaseJson": {
          "path": "patches-bundle.json",
          "downloadUrlTemplate": "https://github.com/${owner}/${repo}/releases/download/v${version}/patches-${version}.mpp",
          "signatureUrlTemplate": ""
        }
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew generatePatchesList           && jq '.version=\"${nextRelease.version}\"' patches-list.json > patches-list.json.tmp && mv patches-list.json.tmp patches-list.json && if [ \"${nextRelease.version}\" = \"2.0.0\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.0.0-mpp.sh; elif [ \"${nextRelease.version}\" = \"2.0.1\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.0.1-mpp.sh; elif [ \"${nextRelease.version}\" = \"2.0.2\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.0.2-mpp.sh; elif [ \"${nextRelease.version}\" = \"2.0.3\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.0.3-mpp.sh; elif [ \"${nextRelease.version}\" = \"2.0.4\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.0.4-mpp.sh; elif [ \"${nextRelease.version}\" = \"2.0.5\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.0.5-mpp.sh; elif [ \"${nextRelease.version}\" = \"2.0.6\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.0.6-mpp.sh; elif [ \"${nextRelease.version}\" = \"2.1.0\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.1.0-mpp.sh; elif [ \"${nextRelease.version}\" = \"2.1.1\" ]; then NICOID_OFFICIAL_RELEASE_APPROVED=APPROVE bash .github/scripts/stage-v2.1.1-mpp.sh; else echo '::error::Unapproved release: no MPP staging script for ${nextRelease.version}' >&2; exit 1; fi && python3 .github/scripts/verify-release-mpp.py record \"${nextRelease.version}\"",
        "successCmd": "git restore -- gradlew.bat",
        "publishCmd": "python3 .github/scripts/verify-release-mpp.py check \"${nextRelease.version}\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "gradle.properties",
          "patches-bundle.json",
          "patches-list.json",
          "patches/src/main/resources/nicoid/helpers.mpe",
          "patches/src/main/resources/nicoid/method-delta.dex",
          "patches/src/main/resources/nicoid/resources.zip"
        ],
        "message": "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "patches/build/libs/patches-!(*sources*|*javadoc*).mpp?(.asc)"
          }
        ],
        "successCommentCondition": false,
        "failCommentCondition": false,
        "releasedLabels": false,
        "labels": false,
        "failComment": false
      }
    ]
  ]
}
