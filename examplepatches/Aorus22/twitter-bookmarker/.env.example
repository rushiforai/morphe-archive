# Copy to .env and adjust. Docker Compose reads .env automatically; the file is
# gitignored because it holds an absolute path from one machine.
#
#   cp .env.example .env
#
# docker-compose.yml only reads these values; it hardcodes neither a path nor a
# port.

# The directory holding tw-bookmarker.db, backup/ and Scripts/ — an absolute path
# on this machine. It is mounted at the *same* path inside the container, so one
# variable is the whole mapping and there is no second container path to keep in
# sync.
TWITTER_BOOKMARKER_DATA_DIR=/home/you/Personal/twitter-bookmarker

# What the server binds. Both containers share the host network, so this is the
# real address on the host, not a published mapping.
TWITTER_BOOKMARKER_ADDR=127.0.0.1:43121

# The uid:gid that owns TWITTER_BOOKMARKER_DATA_DIR (`id -u`, `id -g`). The
# directory is mode 0700, so a container running as anyone else cannot open the
# database.
TWB_UID=1000
TWB_GID=1000

# The bearer token, for clients that cannot answer a password dialog: the phone
# patch, curl, scripts. Over the tunnel it grants the same access as the password
# below, so treat it as one.
TWITTER_BOOKMARKER_TOKEN=

# The browser's password, written user:password, e.g. aorus:a-long-passphrase.
# Anything arriving through a proxy (the tunnel) must present it — the browser
# asks with its own dialog — or present the bearer token above. Requests straight
# from this machine, the desktop extension included, are unaffected, and /health
# stays open so reachability checks keep working.
#
# Leave it unset and the public surface is open to anyone with the URL.
TWITTER_BOOKMARKER_BASIC_AUTH=

# Not read by Compose: this is the address to paste into the extension's custom
# mode and the phone patch. It is served by the host's existing cloudflared
# service, not by the container — see the README section "The public URL".
TWITTER_BOOKMARKER_PUBLIC_URL=https://tw-bookmark-e41fc2b5.nadif.dev
