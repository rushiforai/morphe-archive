# Copy to .env, next to compose.yaml, and fill in (README.md here). Never commit .env.

# The phone stack's folder: its phone/cloud-key/E2E_ADB_KEY.b64 is mounted read-only.
PHONE_STACK=/share/DockerContainersSSD/android-emulator
# The folder the device host serves as /files/: the clean APK and its SHA256SUMS, mounted read-only.
PHONE_ARTIFACTS=/share/DockerContainersSSD/android-emulator/artifacts
# The phone stack's Docker network (docker network ls).
PHONE_NETWORK=android-emulator_default
# The runner's memory limit.
E2E_RUNNER_MEMORY=3g
