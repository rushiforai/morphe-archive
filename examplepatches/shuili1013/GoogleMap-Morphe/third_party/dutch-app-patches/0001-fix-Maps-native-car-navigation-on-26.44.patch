From 2703a1fc24f6076a190aad8b0742703dca8c1423 Mon Sep 17 00:00:00 2001
From: shuili <99980772+shuili1013@users.noreply.github.com>
Date: Sun, 8 Nov 2026 10:17:02 +0800
Subject: [PATCH 1/2] fix(Maps): native car navigation on 26.44

The native car adapter still loaded 26.43's provider binder class `lur`, so on
26.44 every Android Auto session failed with "Maps navigation provider is not
local". In 26.44 CarNavigationProviderService (lvt.onBind) returns lvt.b:Llvp;,
which keeps the same y(int, Parcel, Parcel) dispatch method.

Host-side trip guidance (NativeGuidance) reflects through a Dagger path
(rI/rJ/bR, blkt/blku) that 26.44 also renamed. Make it optional so its failure
is logged instead of ending the car session; the native renderer still draws
the map and turn cards on the car surface.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LD8fYP3NW7C5wsdBmsdLG2
---
 .../maps/gearslip/NativeCarNavigationSession.java   |  4 +++-
 .../patches/maps/gearslip/NativeCarService.java     | 13 +++++++++++--
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/extensions/maps-gearslip/src/main/java/patches/maps/gearslip/NativeCarNavigationSession.java b/extensions/maps-gearslip/src/main/java/patches/maps/gearslip/NativeCarNavigationSession.java
index 85a6701..41e7a6b 100644
--- a/extensions/maps-gearslip/src/main/java/patches/maps/gearslip/NativeCarNavigationSession.java
+++ b/extensions/maps-gearslip/src/main/java/patches/maps/gearslip/NativeCarNavigationSession.java
@@ -31,7 +31,9 @@ public final class NativeCarNavigationSession implements AutoCloseable {
             try {
                 // This Binder is obtained only from the non-exported service in this APK.
                 // Its external onTransact Google-host check remains entirely unchanged.
-                Class<?> type = context.getClassLoader().loadClass("lur");
+                // Maps 26.44 renamed 26.43's provider binder `lur` to `lvp`
+                // (CarNavigationProviderService -> lvt.onBind returns lvt.b:Llvp;).
+                Class<?> type = context.getClassLoader().loadClass("lvp");
                 if (binder == null || binder.getClass() != type || !(binder instanceof Binder))
                     throw new SecurityException("Maps navigation provider is not local");
                 provider = new LocalProvider(binder);
diff --git a/extensions/maps-gearslip/src/main/java/patches/maps/gearslip/NativeCarService.java b/extensions/maps-gearslip/src/main/java/patches/maps/gearslip/NativeCarService.java
index 929fbb0..33354e5 100644
--- a/extensions/maps-gearslip/src/main/java/patches/maps/gearslip/NativeCarService.java
+++ b/extensions/maps-gearslip/src/main/java/patches/maps/gearslip/NativeCarService.java
@@ -308,8 +308,17 @@ public final class NativeCarService extends Service {
             if (session.failure == null) CarProtocol.send(session.appHost, APP_HOST, 4,
                     data -> data.writeStrongBinder(new SurfaceBinder(session)));
             if(session.failure==null){
-                session.guidance=new NativeGuidance(this,main,snapshot->navigation(session,snapshot),error->failed(session,error));
-                if(session.failure!=null){session.guidance.close();session.guidance=null;}
+                // Host-side trip guidance is optional: the native renderer already draws
+                // the map and turn cards on the car surface. On Maps 26.44 the Dagger path
+                // NativeGuidance reflects through (rI/rJ/bR, blkt/blku) was renamed, so a
+                // failure here must not take the whole car session down with it.
+                try{
+                    session.guidance=new NativeGuidance(this,main,snapshot->navigation(session,snapshot),
+                            error->android.util.Log.w("MapsNativeCar","Native guidance stopped",error));
+                }catch(Exception error){
+                    android.util.Log.w("MapsNativeCar","Native guidance unavailable; continuing without host trip updates",error);
+                    session.guidance=null;
+                }
             }
         });
     }
