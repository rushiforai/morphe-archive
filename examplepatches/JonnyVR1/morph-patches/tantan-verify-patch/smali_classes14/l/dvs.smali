.class public Ll/dvs;
.super Ll/mus;
.source "SourceFile"


# annotations
.annotation system Ldalvik/annotation/Signature;
    value = {
        "<V::",
        "Ll/iam;",
        ">",
        "Ll/mus<",
        "TV;>;"
    }
.end annotation


# direct methods
.method public constructor <init>(Ll/ner;Ll/nus;)V
    .locals 0

    .line 1
    invoke-direct {p0, p1, p2}, Ll/mus;-><init>(Ll/ner;Ll/nus;)V

    .line 2
    .line 3
    .line 4
    return-void
.end method
