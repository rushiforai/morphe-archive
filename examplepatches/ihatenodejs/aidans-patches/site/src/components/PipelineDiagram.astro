---
// Technical pipeline diagram illustrating repository data flow and Cloudflare version freshness
---

<div class="border border-white/[0.08] bg-[#080808] p-6 space-y-6 relative overflow-hidden">
  <!-- Corner crosshairs -->
  <span class="absolute -top-[5px] -left-[4px] select-none text-[9px] font-mono text-zinc-600 leading-none pointer-events-none">+</span>
  <span class="absolute -top-[5px] -right-[4px] select-none text-[9px] font-mono text-zinc-600 leading-none pointer-events-none">+</span>
  <span class="absolute -bottom-[5px] -left-[4px] select-none text-[9px] font-mono text-zinc-600 leading-none pointer-events-none">+</span>
  <span class="absolute -bottom-[5px] -right-[4px] select-none text-[9px] font-mono text-zinc-600 leading-none pointer-events-none">+</span>

  <div class="flex items-center justify-between border-b border-white/[0.08] pb-4">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
      <h4 class="font-mono text-xs uppercase tracking-wider text-zinc-300">Data Architecture &amp; Lineage</h4>
    </div>
    <span class="font-mono text-[10px] text-zinc-500">Zero-Manual-Entry Pipeline</span>
  </div>

  <div class="space-y-6">
    <!-- Pipeline 1: Build-Time Ingestion -->
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-400 uppercase tracking-wider">
        <span class="text-zinc-600">01</span>
        <span>Build-Time Metadata Ingestion</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-4 gap-2 text-center font-mono text-xs">
        <div class="p-3 bg-zinc-950 border border-white/[0.08] rounded-sm flex flex-col justify-center items-center">
          <span class="text-zinc-300 font-semibold">Kotlin Source</span>
          <span class="text-[10px] text-zinc-500 mt-1">patches/src/</span>
        </div>
        <div class="hidden sm:flex items-center justify-center text-zinc-600 text-sm">&rarr;</div>
        <div class="p-3 bg-zinc-950 border border-white/[0.08] rounded-sm flex flex-col justify-center items-center">
          <span class="text-zinc-300 font-semibold">patches-list.json</span>
          <span class="text-[10px] text-zinc-500 mt-1">Generated by Gradle</span>
        </div>
        <div class="hidden sm:flex items-center justify-center text-zinc-600 text-sm">&rarr;</div>
        <div class="p-3 bg-blue-950/30 border border-blue-800/40 rounded-sm flex flex-col justify-center items-center sm:col-start-4">
          <span class="text-blue-300 font-semibold">Astro Site</span>
          <span class="text-[10px] text-blue-400/80 mt-1">Static Rendering</span>
        </div>
      </div>
    </div>

    <!-- Pipeline 2: Runtime Freshness Monitoring -->
    <div class="space-y-2 pt-4 border-t border-white/[0.06]">
      <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-400 uppercase tracking-wider">
        <span class="text-zinc-600">02</span>
        <span>Daily Version Freshness Monitoring</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-4 gap-2 text-center font-mono text-xs">
        <div class="p-3 bg-zinc-950 border border-white/[0.08] rounded-sm flex flex-col justify-center items-center">
          <span class="text-zinc-300 font-semibold">Google Play</span>
          <span class="text-[10px] text-zinc-500 mt-1">Store Web API</span>
        </div>
        <div class="hidden sm:flex items-center justify-center text-zinc-600 text-sm">&rarr;</div>
        <div class="p-3 bg-zinc-950 border border-white/[0.08] rounded-sm flex flex-col justify-center items-center">
          <span class="text-zinc-300 font-semibold">Cloudflare Cron</span>
          <span class="text-[10px] text-zinc-500 mt-1">Daily 06:00 UTC</span>
        </div>
        <div class="hidden sm:flex items-center justify-center text-zinc-600 text-sm">&rarr;</div>
        <div class="p-3 bg-emerald-950/30 border border-emerald-800/40 rounded-sm flex flex-col justify-center items-center sm:col-start-4">
          <span class="text-emerald-300 font-semibold">KV Cache &amp; Status</span>
          <span class="text-[10px] text-emerald-400/80 mt-1">/status Client Feed</span>
        </div>
      </div>
    </div>
  </div>

  <div class="pt-4 border-t border-white/[0.08] flex flex-wrap items-center justify-between gap-4 font-mono text-[11px] text-zinc-500">
    <div class="flex items-center gap-4">
      <a href="https://github.com/ihatenodejs/aidans-patches/tree/main/patches" target="_blank" rel="noreferrer" class="hover:text-zinc-300 transition-colors">
        View Patch Source &rarr;
      </a>
      <a href="https://raw.githubusercontent.com/ihatenodejs/aidans-patches/main/patches-list.json" target="_blank" rel="noreferrer" class="hover:text-zinc-300 transition-colors">
        Raw JSON &rarr;
      </a>
    </div>
    <a href="/status" class="text-zinc-300 hover:text-white underline">
      Open Status Matrix &rarr;
    </a>
  </div>
</div>
