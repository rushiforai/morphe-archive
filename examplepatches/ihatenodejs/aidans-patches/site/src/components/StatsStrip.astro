---
import { getRepositoryStats } from '../data/repo';

const stats = getRepositoryStats();
---

<div class="relative w-full border-y border-white/[0.08] bg-[#070707]">
  <!-- Corner intersection crosshairs -->
  <span class="absolute -top-[5px] -left-[4px] select-none text-[9px] font-mono text-zinc-600 leading-none pointer-events-none">+</span>
  <span class="absolute -top-[5px] -right-[4px] select-none text-[9px] font-mono text-zinc-600 leading-none pointer-events-none">+</span>
  <span class="absolute -bottom-[5px] -left-[4px] select-none text-[9px] font-mono text-zinc-600 leading-none pointer-events-none">+</span>
  <span class="absolute -bottom-[5px] -right-[4px] select-none text-[9px] font-mono text-zinc-600 leading-none pointer-events-none">+</span>

  <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-white/[0.08]">
    <!-- Stat 1 -->
    <div class="px-6 py-5 flex flex-col justify-center">
      <span class="font-mono text-[11px] text-zinc-500 uppercase tracking-wider mb-1">Applications</span>
      <div class="flex items-baseline gap-2">
        <span class="font-sans text-2xl font-bold tracking-tight text-white">{stats.supportedAppsCount}</span>
        <span class="font-mono text-xs text-zinc-400">supported</span>
      </div>
    </div>

    <!-- Stat 2 -->
    <div class="px-6 py-5 flex flex-col justify-center">
      <span class="font-mono text-[11px] text-zinc-500 uppercase tracking-wider mb-1">Total Patches</span>
      <div class="flex items-baseline gap-2">
        <span class="font-sans text-2xl font-bold tracking-tight text-white">{stats.totalPatchesCount}</span>
        <span class="font-mono text-xs text-zinc-400">curated</span>
      </div>
    </div>

    <!-- Stat 3 -->
    <div class="px-6 py-5 flex flex-col justify-center">
      <span class="font-mono text-[11px] text-zinc-500 uppercase tracking-wider mb-1">Bundle Release</span>
      <div class="flex items-baseline gap-2">
        <span class="font-sans text-2xl font-bold tracking-tight text-white font-mono">v{stats.bundleVersion}</span>
      </div>
    </div>

    <!-- Stat 4 -->
    <div class="px-6 py-5 flex flex-col justify-center">
      <span class="font-mono text-[11px] text-zinc-500 uppercase tracking-wider mb-1">Last Updated</span>
      <div class="flex items-baseline gap-2">
        <span class="font-sans text-xl font-bold tracking-tight text-white font-mono">{stats.releaseDate}</span>
      </div>
    </div>
  </div>
</div>
