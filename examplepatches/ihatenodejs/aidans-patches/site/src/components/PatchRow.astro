---
import type { Patch } from '../data/types';

interface Props {
  patch: Patch;
  appId: string;
}

const { patch, appId } = Astro.props;
const anchorId = `${appId}-${patch.id}`;
---

<div
  id={anchorId}
  data-patch-card
  data-patch-name={patch.name.toLowerCase()}
  data-patch-desc={patch.description.toLowerCase()}
  data-app-id={appId}
  data-is-default={patch.default ? 'true' : 'false'}
  data-has-options={patch.options.length > 0 ? 'true' : 'false'}
  class="relative bg-[#090909] border border-white/[0.08] p-5 hover:border-white/[0.18] transition-colors rounded-sm group flex flex-col justify-between permalink-target"
>
  <div class="space-y-3">
  <!-- Header: Patch Name & Badges -->
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <a href={`#${anchorId}`} class="font-sans text-sm font-semibold text-white group-hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span>{patch.name}</span>
          <span class="text-zinc-600 text-xs opacity-0 group-hover:opacity-100 transition-opacity font-mono">#</span>
        </a>
      </div>
    </div>

    <!-- Status Badges -->
    <div class="flex flex-wrap items-center gap-1.5 shrink-0 font-mono text-[10px]">
      {patch.default ? (
        <span class="px-2 py-0.5 rounded-sm bg-emerald-950/50 text-emerald-400 border border-emerald-800/40">
          Default
        </span>
      ) : (
        <span class="px-2 py-0.5 rounded-sm bg-zinc-900 text-zinc-400 border border-white/10">
          Optional
        </span>
      )}

      {patch.options.length > 0 && (
        <span class="px-2 py-0.5 rounded-sm bg-blue-950/50 text-blue-400 border border-blue-800/40">
          {patch.options.length} {patch.options.length === 1 ? 'option' : 'options'}
        </span>
      )}
    </div>
  </div>

  <!-- Description -->
  <p class="text-xs text-zinc-300 leading-relaxed">
    {patch.description}
  </p>

  <!-- Dependencies -->
  {patch.dependencies.length > 0 && (
    <div class="p-2.5 bg-zinc-950/70 border border-white/[0.04] rounded-sm font-mono text-[11px] flex items-center gap-2 text-zinc-400">
      <span class="text-amber-500/90 text-xs">&bull;</span>
      <span class="text-zinc-500">Requires:</span>
      <div class="flex flex-wrap gap-1">
        {patch.dependencies.map((dep) => (
          <span class="text-zinc-300 bg-white/[0.04] px-1.5 py-0.5 rounded border border-white/[0.06]">
            {dep}
          </span>
        ))}
      </div>
    </div>
  )}

  <!-- Options (Expandable) -->
  {patch.options.length > 0 && (
    <details class="group/options pt-1">
      <summary class="font-mono text-xs text-zinc-400 hover:text-white cursor-pointer select-none flex items-center gap-1.5 py-1">
        <span class="text-zinc-500 group-open/options:rotate-90 transition-transform">&gt;</span>
        <span class="underline decoration-zinc-700 underline-offset-4">
          View {patch.options.length} configurable {patch.options.length === 1 ? 'option' : 'options'}
        </span>
      </summary>

      <div class="mt-3 space-y-3 pt-3 border-t border-white/[0.06]">
        {patch.options.map((opt) => (
          <div class="p-3 bg-zinc-950 border border-white/[0.06] rounded-sm space-y-1.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-sans text-xs font-semibold text-white">{opt.title}</span>
              <div class="flex items-center gap-2 font-mono text-[10px]">
                {opt.type === 'boolean' ? (
                  Boolean(opt.default) ? (
                    <span class="px-2 py-0.5 rounded-sm bg-emerald-950/60 text-emerald-400 border border-emerald-800/40">
                      Enabled by Default
                    </span>
                  ) : (
                    <span class="px-2 py-0.5 rounded-sm bg-zinc-900 text-zinc-400 border border-white/10">
                      Disabled by Default
                    </span>
                  )
                ) : (
                  <>
                    <span class="px-1.5 py-0.5 bg-white/[0.04] border border-white/[0.08] text-zinc-400 rounded-sm">
                      {opt.type}
                    </span>
                    <span class="px-1.5 py-0.5 bg-zinc-900 border border-white/10 text-zinc-300 rounded-sm">
                      default: {String(opt.default)}
                    </span>
                  </>
                )}
                {opt.required && (
                  <span class="px-1.5 py-0.5 bg-rose-950/60 text-rose-400 border border-rose-800/40 rounded-sm">
                    required
                  </span>
                )}
              </div>
            </div>

            <p class="text-[11px] text-zinc-400 leading-normal">{opt.description}</p>
            <div class="font-mono text-[10px] text-zinc-500">Key: <code class="text-zinc-400">{opt.key}</code></div>
          </div>
        ))}
      </div>
    </details>
  )}

  </div>

  <!-- Footer Link to Kotlin Source -->
  <div class="mt-4 pt-1 flex items-center justify-between text-[11px] font-mono text-zinc-500">
    <a
      href={patch.sourceUrl}
      target="_blank"
      rel="noreferrer"
      class="hover:text-zinc-300 transition-colors flex items-center gap-1"
    >
      <span>Kotlin source</span>
      <svg class="w-3 h-3 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>

    <a href={`#${anchorId}`} class="hover:text-zinc-300 transition-colors">
      Permalink
    </a>
  </div>
</div>
