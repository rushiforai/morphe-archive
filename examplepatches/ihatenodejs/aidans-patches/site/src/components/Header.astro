---
import { Image } from 'astro:assets';
import { getRepositoryStats } from '../data/repo';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const stats = getRepositoryStats();
---

<header class="sticky top-0 z-50 w-full bg-[#050505]/90 backdrop-blur-md border-b border-white/[0.08]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Brand & Version -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 group transition-colors">
        <Image
          src="/aidan.jpeg"
          alt="Aidan"
          width={24}
          height={24}
          loading="eager"
          class="w-6 h-6 rounded-full object-cover border border-white/20"
        />
        <span class="font-sans text-sm font-medium tracking-tight text-white group-hover:text-zinc-200">
          Aidan's <span class="hidden sm:inline">Morphe </span>Patches
        </span>
      </a>

      <a
        href="https://github.com/ihatenodejs/aidans-patches/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[11px] font-mono tracking-tight text-zinc-400 bg-zinc-900/80 border border-white/10 rounded-sm hover:border-white/30 hover:text-zinc-200 transition-colors"
      >
        v{stats.bundleVersion}
      </a>
    </div>

    <!-- Navigation -->
    <nav class="flex items-center gap-1 sm:gap-2">
      <a
        href="/patches"
        class={`px-3 py-1 text-xs font-medium rounded-sm transition-colors ${
          currentPath.startsWith('/patches')
            ? 'text-white bg-white/[0.06] border border-white/[0.12]'
            : 'text-zinc-400 hover:text-white hover:bg-white/[0.03]'
        }`}
      >
        Patches
      </a>
      <a
        href="/status"
        class={`px-3 py-1 text-xs font-medium rounded-sm transition-colors ${
          currentPath.startsWith('/status')
            ? 'text-white bg-white/[0.06] border border-white/[0.12]'
            : 'text-zinc-400 hover:text-white hover:bg-white/[0.03]'
        }`}
      >
        Status
      </a>
      <a
        href="https://github.com/ihatenodejs/aidans-patches"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1 text-xs font-medium text-zinc-400 hover:text-white hover:bg-white/[0.03] rounded-sm transition-colors flex items-center gap-1"
      >
        <span>GitHub</span>
        <svg class="w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </div>
</header>
