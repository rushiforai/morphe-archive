{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "bump",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "build",
            "scope": "Needs bump",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "fix",
              "section": "🐛 Bug Fixes",
              "hidden": false
            },
            {
              "type": "feat",
              "section": "✨ New Features",
              "hidden": false
            },
            {
              "type": "bump",
              "section": "🚀 Updated App Support",
              "hidden": false
            },
            {
              "type": "perf",
              "section": "🔧 Improvements",
              "hidden": false
            },
            {
              "type": "build",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "./tooling/changelog/index.js",
      {
        "releaseJson": {
          "path": "patches-bundle.json",
          "downloadUrlTemplate": "https://gitlab.com/${owner}/${repo}/-/releases/v${version}/downloads/patches-${version}.mpp",
          "signatureUrlTemplate": ""
        }
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "SOURCE_RELEASE_VERSION=${nextRelease.version} ./gradlew --no-daemon -Pversion=${nextRelease.version} :patches:buildAndroid :patches:generatePatchesList :patches:verifySourceMetadata && python3 .github/scripts/generate_patches_readme.py \"$CI_PROJECT_PATH\" \"$CI_COMMIT_BRANCH\" patches-list.json README.md && python3 -c \"from pathlib import Path; import re; p=Path('gradle.properties'); p.write_text(re.sub(r'(?m)^version\\s*=.*$', 'version = ${nextRelease.version}', p.read_text()))\" && (cd patches/build/libs && sha256sum patches-${nextRelease.version}.mpp) > SHA256SUMS.txt"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "gradle.properties",
          "patches-bundle.json",
          "patches-list.json",
          "README.md",
          "SHA256SUMS.txt"
        ],
        "message": "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/gitlab",
      {
        "successComment": false,
        "assets": [
          {
            "target": "generic_package",
            "filepath": "/patches-${nextRelease.version}.mpp",
            "packageName": "personal-niagara-weather",
            "path": "patches/build/libs/patches-${nextRelease.version}.mpp"
          },
          {
            "target": "generic_package",
            "filepath": "/SHA256SUMS.txt",
            "packageName": "personal-niagara-weather",
            "path": "SHA256SUMS.txt"
          }
        ],
        "useJobToken": true,
        "failComment": false
      }
    ],
    [
      "@cleyrop-org/semantic-release-backmerge",
      {
        "backmergeBranches": [
          {
            "from": "main",
            "to": "dev"
          }
        ],
        "clearWorkspace": true,
        "backmergeStrategy": "merge",
        "forcePush": false
      }
    ]
  ],
  "repositoryUrl": "https://gitlab.com/rokuOP/personal-niagara-weather.git"
}
