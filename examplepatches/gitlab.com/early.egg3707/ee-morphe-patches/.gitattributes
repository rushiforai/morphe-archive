#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Default: keep text files LF in this repo
*               text=auto eol=lf

# Git metadata files should stay LF
/.gitattributes text eol=lf

# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# CI and config files should stay LF across platforms
*.yml           text eol=lf
*.yaml          text eol=lf
