{
  "repositoryUrl": "https://gitlab.com/early.egg3707/ee-morphe-patches.git",
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer", {
        "releaseRules": [
          { "type": "build", "scope": "Needs bump", "release": "patch" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "./scripts/semantic-release/release-json.cjs",
      {
        "path": "patches-bundle.json"
      }
    ],
    "gradle-semantic-release-plugin",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "jq '.version=\"${nextRelease.version}\"' patches-list.json > patches-list.json.tmp && mv patches-list.json.tmp patches-list.json"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "patches-bundle.json",
          "patches-list.json",
          "gradle.properties"
        ],
        "message": "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/gitlab",
      {
        "assets": [
          {
            "path": "patches/build/libs/patches-${nextRelease.version}.mpp",
            "label": "Morphe patches bundle",
            "filepath": "/patches-${nextRelease.version}.mpp"
          },
          {
            "path": "patches/build/libs/patches-${nextRelease.version}.mpp.asc",
            "label": "Morphe patches signature",
            "filepath": "/patches-${nextRelease.version}.mpp.asc"
          }
        ],
        "successComment": false
      }
    ],
    [
      "@saithodev/semantic-release-backmerge",
      {
        "backmergeBranches": [{"from": "main", "to": "dev"}],
        "clearWorkspace": true
      }
    ]
  ]
}
