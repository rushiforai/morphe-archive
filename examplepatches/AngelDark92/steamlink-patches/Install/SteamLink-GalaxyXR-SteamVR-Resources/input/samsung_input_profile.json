{
  "jsonid": "input_profile",
  "controller_type": "oculus_touch",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "vrlink",
  "driver_name": "vrlink",
  "hand_priority": -1,
  "legacy_binding": "{vrlink}/input/legacy_bindings_samsung.json",
  "input_bindingui_mode": "controller_handed",
  "should_show_binding_errors": true,
  "input_bindingui_left": {
    "image": "{vrlink}/icons/samsung_touch_left.svg"
  },
  "input_bindingui_right": {
    "image": "{vrlink}/icons/samsung_touch_right.svg"
  },
  "input_source": {
    "/input/joystick": {
      "type": "joystick",
      "binding_image_point": [ 30, 40 ],
      "click": true,
      "touch": true,
      "order": 2
    },
    "/input/trigger": {
      "type": "trigger",
      "binding_image_point": [ 32, 100 ],
      "value": true,
      "touch": true,
      "order": 1
    },
    "/input/grip": {
      "type": "trigger",
      "binding_image_point": [ 85, 90 ],
      "value": true,
      "touch": true,
      "order": 3
    },
    "/input/a": {
      "type": "button",
      "side": "right",
      "binding_image_point": [ 50, 50 ],
      "click": true,
      "touch": true,
      "order": 4
    },
    "/input/b": {
      "type": "button",
      "side": "right",
      "binding_image_point": [ 35, 55 ],
      "click": true,
      "touch": true,
      "order": 5
    },
    "/input/x": {
      "type": "button",
      "side": "left",
      "binding_image_point": [ 50, 50 ],
      "click": true,
      "touch": true,
      "order": 4
    },
    "/input/y": {
      "type": "button",
      "side": "left",
      "binding_image_point": [ 35, 55 ],
      "click": true,
      "touch": true,
      "order": 5
    },
    "/input/system": {
      "type": "button",
      "side": "left",
      "binding_image_point": [ 72, 39 ],
      "click": true,
      "touch": true,
      "order": 0
    },
    "/input/thumbrest": {
      "type": "button",
      "binding_image_point": [ 55, 65 ],
      "click": false,
      "touch": true
    },
    "/input/skeleton/right": {
      "type": "skeleton",
      "side": "right",
      "skeleton": "/skeleton/hand/right",
      "binding_image_point": [ 75, 75 ]
    },
    "/input/skeleton/left": {
      "type": "skeleton",
      "side": "left",
      "skeleton": "/skeleton/hand/left",
      "binding_image_point": [ 75, 75 ]
    },
    "/output/haptic": {
      "type": "vibration",
      "binding_image_point": [ 72, 39 ]
    },
    "/pose/raw": {
      "type": "pose",
      "binding_image_point": [ 14, 16 ]
    },
    "/pose/base": {
      "type": "pose",
      "binding_image_point": [ 11, 150 ]
    },
    "/pose/handgrip": {
      "type": "pose",
      "binding_image_point": [ 24, 86 ]
    },
    "/pose/tip": {
      "type": "pose",
      "binding_image_point": [ 14, 16 ]
    },
    "/pose/openxr_aim": {
      "type": "pose",
      "binding_image_point": [ 14, 16 ]
    },
    "/pose/openxr_grip": {
      "type": "pose",
      "binding_image_point": [ 24, 86 ]
    }
  },
  "default_bindings": [
    {
      "app_key": "openvr.component.vrcompositor",
      "binding_url": "vrcompositor_bindings_touch.json"
    },
    {
      "app_key": "openvr.tool.steamvr_environments",
      "binding_url": "openvr.tool.steamvr_environments_samsung_touch.json"
    },
    {
      "app_key": "steam.app.722230",
      "binding_url": "bindings/steam.app.722230_samsung_touch_bindings.json"
    },
    {
      "app_key": "steam.app.916840",
      "binding_url": "bindings/steam.app.916840_samsung_touch_bindings.json"
    },
    {
      "app_key": "steam.app.1947500",
      "binding_url": "bindings/steam.app.1947500_samsung_touch_bindings.json"
    }
  ]
}
