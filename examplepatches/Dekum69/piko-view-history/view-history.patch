++
++      - name: Setup Java
++        uses: actions/setup-java@v6
++        with:
++          distribution: 'temurin'
++          java-version: '17'
++
++      - name: Cache Gradle
++        uses: burrunan/gradle-cache-action@v3
++
++      - name: Build
++        env:
++          # Needed to read app.morphe:morphe-patches-library from GitHub Packages.
