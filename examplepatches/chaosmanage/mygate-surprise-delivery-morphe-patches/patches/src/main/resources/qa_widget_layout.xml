<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">
    <LinearLayout
        android:id="@+id/qa_widget_hit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/qa_widget_bg"
        android:gravity="center"
        android:padding="4dp"
        android:contentDescription="Approve Surprise Delivery for one hour"
        android:clickable="true">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginBottom="3dp"
            android:src="@drawable/qa_widget_icon"
            android:contentDescription="Delivery" />
        <TextView
            android:id="@+id/qa_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APPROVE\nDELIVERY"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:fontFamily="sans"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/qa_widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="1 HOUR"
            android:textColor="#FFDCD8FF"
            android:textStyle="bold"
            android:textSize="8sp"
            android:gravity="center"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
