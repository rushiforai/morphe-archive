{
  "about": "Addon track matching: a YouTube Music song (target) against an addon's search rows (candidates). expect is what BitChord's TrackMatcher returns: ranked = accepted rows best first (pick = ranked[0]), scores = each accepted row's score, rejected = rows it refuses. Filled by scripts/addon_matcher_fixtures.mjs --update from BitChord v1.9.2 (a2d886e6) web/app/src/data/match/trackMatcher.ts. Cases named (ours, …) are our rules on top of BitChord a2d886e6 (protocol.md §7), their expect checked by hand.",
  "cases": [
    {
      "name": "exact row wins; a row 45 s longer by the same artist is kept at 0 length points (shared-artist rows may drift up to 90 s)",
      "target": {
        "title": "Blinding Lights",
        "artist": "The Weeknd",
        "durationSec": 200,
        "album": "After Hours"
      },
      "candidates": [
        {
          "id": "remix",
          "title": "Blinding Lights (Chromatics Remix)",
          "artist": "The Weeknd",
          "durationSec": 271,
          "album": null
        },
        {
          "id": "extended",
          "title": "Blinding Lights",
          "artist": "The Weeknd",
          "durationSec": 245,
          "album": "After Hours"
        },
        {
          "id": "album",
          "title": "Blinding Lights",
          "artist": "The Weeknd",
          "durationSec": 200.4,
          "album": "After Hours"
        }
      ],
      "expect": {
        "pick": "album",
        "ranked": [
          "album",
          "extended"
        ],
        "scores": {
          "extended": 160,
          "album": 200
        },
        "rejected": [
          "remix"
        ]
      }
    },
