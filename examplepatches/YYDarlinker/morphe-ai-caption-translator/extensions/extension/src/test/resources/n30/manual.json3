    "segs": [ {
      "utf8": "actually..."
    } ]
  }, {
    "tStartMs": 357845,
    "dDurationMs": 2676,
    "segs": [ {
      "utf8": "coming off of the back of the phone,\nlike it's gonna..."
    } ]
  }, {
    "tStartMs": 360603,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "You're gonna have to take my word\nfor it because it's extremely"
    } ]
