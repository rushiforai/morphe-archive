  }, {
    "tStartMs": 348303,
    "dDurationMs": 2906,
    "segs": [ {
      "utf8": "They didn't say much about it\nin any of the press releases,"
    } ]
  }, {
    "tStartMs": 351291,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "but it's like this\nholographic 3D butterfly"
    } ]
  }, {
    "tStartMs": 353939,
    "dDurationMs": 921,
    "segs": [ {
      "utf8": "wing type of thing."
    } ]
  }, {
    "tStartMs": 355180,
    "dDurationMs": 1753,
    "segs": [ {
      "utf8": "It looks to my eye...\nlike it's..."
