    "segs": [ {
      "utf8": "difficult to capture on camera..."
    } ]
  }, {
    "tStartMs": 365821,
    "dDurationMs": 1114,
    "segs": [ {
      "utf8": "But I swear this is..."
    } ]
  }, {
    "tStartMs": 367017,
    "dDurationMs": 3832,
    "segs": [ {
      "utf8": "one of the best lenticular lens effects\nI've ever seen with my own eyes."
    } ]
  }, {
    "tStartMs": 371331,
    "dDurationMs": 1169,
    "segs": [ {
      "utf8": "It's absolutely insane."
