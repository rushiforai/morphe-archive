    "dDurationMs": 1203,
    "segs": [ {
      "utf8": "feeding into that too."
    } ]
  }, {
    "tStartMs": 328931,
    "dDurationMs": 3598,
    "segs": [ {
      "utf8": "But you know what I didn't find\non that press release that they"
