+    private static Plan parseInternal(
+            String content,
+            RebuildSource s,
+            RebuildPlanner.Block b,
+            boolean mayRebind,
+            int reboundEvents,
+            CaptionLanguageContext context,
+            boolean prefix)
+            throws Exception {
+        String raw = content == null ? "" : content.trim();
+        if (raw.startsWith("```json\n") && raw.endsWith("```"))
