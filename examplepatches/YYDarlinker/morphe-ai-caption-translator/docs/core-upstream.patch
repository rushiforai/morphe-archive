+        // overlaps a long hold is a later caption, not a second copy of this one.
+        List<Span> clusters = new ArrayList<>(spans.size());
+        for (Span span : spans) {
+            Span previous = clusters.isEmpty() ? null : clusters.get(clusters.size() - 1);
