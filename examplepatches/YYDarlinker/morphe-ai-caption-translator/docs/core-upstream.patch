+                if (mayRebind) {
+                    int changed = alignBySource(root, s, b);
+                    if (changed > 0)
+                        return parseInternal(root.toString(), s, b, false, changed, context);
+                }
+                throw new Invalid("source_coverage");
+            }
+            Object t = e.opt("text");
+            if (!(t instanceof String)) throw new Invalid("text_type");
+            String text =
+                    ((String) t)
+                            .replace('\r', ' ')
+                            .replace('\n', ' ')
+                            .replaceAll("[\\t ]+", " ")
+                            .trim();
