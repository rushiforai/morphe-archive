-  private static int blockAt(Session s, long time) {
-    if (s.blocks == null) return -1;
-    int lo = 0, hi = s.blocks.size() - 1;
-    while (lo <= hi) {
-      int m = (lo + hi) >>> 1;
-      if (s.blocks.get(m).start <= time) lo = m + 1;
-      else hi = m - 1;
-    }
-    return hi;
-  }
