        <!-- . , ? ! ' -->
        <mapping key_id="{{0x7f0b22de}}" view_id="@id/B01" />
        <mapping key_id="{{0x7f0b0cf4}}" view_id="@id/B02" />
        <mapping key_id="{{0x7f0b2305}}" view_id="@id/B03" />
        <mapping key_id="{{0x7f0b103a}}" view_id="@id/B04" />
