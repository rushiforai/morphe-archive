        <mapping key_id="{{0x7f0b098a}}" view_id="@id/D08" />
        <mapping key_id="{{0x7f0b22fd}}" view_id="@id/D09" />
        <mapping key_id="{{0x7f0b0fee}}" view_id="@id/D10" />
        <!-- _ \ | ~ < > € £ ¥ • -->
        <mapping key_id="{{0x7f0b1f98}}" view_id="@id/C01" />
        <mapping key_id="{{0x7f0b232f}}" view_id="@id/C02" />
        <mapping key_id="{{0x7f0b287e}}" view_id="@id/C03" />
        <mapping key_id="{{0x7f0b2837}}" view_id="@id/C04" />
