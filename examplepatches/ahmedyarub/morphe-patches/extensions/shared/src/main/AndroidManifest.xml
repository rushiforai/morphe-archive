<?xml version="1.0" encoding="utf-8"?>
<!--
  Never shipped: extensions compile to a DEX merged into the host app, which supplies the real
  manifest. Declared here only so lint can see that the download notification MediaDownloader
  posts is permitted — Instagram itself holds POST_NOTIFICATIONS.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
