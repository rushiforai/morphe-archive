# Pinned upstream artifacts.
#
# Every download in scripts/lib/common.sh is verified against the sha256 values
# below. A mismatch aborts the build. Update a pin only on purpose, then copy
# the digest from the release asset metadata (GitHub publishes it) or from
# `shasum -a 256 <file>` after checking the source yourself.
#
# patcher.jar lives in the PixelBoard repository. The URL below points at a
# commit, not at a branch, so a moved branch cannot change the file that gets
# executed by the build.
#
# Commit: a5bdb3be26dd3db6d1d4f2ab3f165add0c8c99d8 ("Initial commit")
PATCHER_JAR_COMMIT="a5bdb3be26dd3db6d1d4f2ab3f165add0c8c99d8"
PATCHER_JAR_SHA256="82a0df2ff881d83d5ca8b4f9a6ce196bd4ac3b87ff147fe37845c296b436806c"

# Release: Akshayykadam/PixelBoard 1.2.0
# The upstream project re-tagged this release, the tag v18.4.1-Stable-V7 is
# gone. The assets and their digests did not change, only the tag moved.
PIXELBOARD_RELEASE_TAG="1.2.0"
PIXELBOARD_APK_ASSET="PixelBoard-18.4.1-V7.apk"
PIXELBOARD_MPP_ASSET="patches-1.2.0.mpp"
PIXELBOARD_APK_SHA256="d16910e04ab027816b2e5929e67f0aa2fffa6154b9ec49aad3a3336a35b491ff"
PIXELBOARD_MPP_SHA256="b165e2cb6cda49b45985f9e981ecf1570fdfb503957c360ab202f2c588a85b9f"

# Gboard base for the patched APK builds. Hosted on the build-inputs release of
# this repository so the CI job and a local build fetch the same file.
GBOARD_BASE_APK_URL="https://github.com/ShubhamJ010/gboard-clipboard-history/releases/download/build-inputs/gboard-merged.apk"
GBOARD_BASE_APK_SHA256="0a12a1f82828145d7c4faba4f3151ed018d1aee3b7337c438835d3b9e9c21da0"
