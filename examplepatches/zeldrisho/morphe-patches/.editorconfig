root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
ktlint_standard_no-wildcard-imports = disabled

[**/Fingerprints.kt]
# Fingerprints are grouped by patch, even when a patch currently has only one.
ktlint_standard_filename = disabled

[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true
