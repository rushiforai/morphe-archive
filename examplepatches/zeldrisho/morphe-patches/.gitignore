### Java template
# Compiled class file
*.class

# Log file
*.log

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

### JetBrains template
# Covers IntelliJ / Android Studio. Blanket .idea/ ignore lives below;
# only module-file fallout outside .idea/ needs separate rules.
*.iml
*.ipr
*.iws

# IntelliJ build output
out/

### Gradle template
.gradle
**/build/
!src/**/build/

# Kotlin compiler/session caches
.kotlin/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Cache of project
.gradletasknamecache

# # Work around https://youtrack.jetbrains.com/issue/IDEA-116898
# gradle/wrapper/gradle-wrapper.properties

# Potentially copyrighted test APK
*.apk

# Ignore vscode config
.vscode/

# Dependency directories
node_modules/

# Python bytecode caches (created by unittest discovery)
__pycache__/

# Project gradle.properties is tracked and release-owned (version pin).
# Never put tokens in it; use ~/.gradle/gradle.properties instead.

# Ignore IDEA files
.idea/
local.properties

# Per-app reverse-engineering work (APK, smali, decompiled)
analysis/

# Legacy repo-root copy of the extension dex (no longer generated nor consumed;
# the .mpp embeds extensions/extension.mpe via plugin resources). Kept ignored
# so a stale local copy can never be committed.
/extensions/extension.mpe

# Local signing keys (never commit private keys)
*.keystore
*.bks
*.jks
*.p12
*.pfx
