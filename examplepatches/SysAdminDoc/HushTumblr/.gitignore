# Gradle files
.gradle/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log
*.bak

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
# The AppInventory contract's two tiny real-dex fixtures (scripts/checks/build-inventory-fixtures.ps1).
!scripts/checks/inventory-fixture/*.apk
*.apkm
*.apks
*.xapk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# NPM modules
node_modules/

# Python bytecode caches
__pycache__/
*.pyc

# Release provenance receipts, published on the release beside the .mpp they describe
release-receipt-*.json

# Tumblr APK fixtures stay local: they are Tumblr's binaries and never go in the repo
fixtures/

# Local clones of the patch sources this bundle was assembled from (read, never committed).
# The ledger of those sources is the one file in there that is tracked.
/sources/*
!/sources/tumblr-sources.json

# Keep the selected marketing artwork with the project; assets/ holds what ships.

# Local working notes
CLAUDE.md
CODEX_CHANGELOG.md
.claude/
.mockups/

# Research notes (regenerated by research passes)
RESEARCH.md
Roadmap_Blocked.md

# Keep working and operations documents local; publish usage and release notes.
*.md
!README.md
!CHANGELOG.md
!docs/tumblr-46.9.1.100-factory-map.md
