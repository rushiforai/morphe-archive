# Gradle files
.gradle/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log
*.bak

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
*.apkm
*.apks
*.xapk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# The bundle signing key's private half lives outside the tree. morphe-signing.pub is its public half.
morphe-signing.key
*.signing.key

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# NPM modules
node_modules/

# Python bytecode caches
__pycache__/
*.pyc

# Release provenance receipts, published on the release beside the .mpp they describe
release-receipt-*.json

# Pinterest APK fixtures stay local: they are Pinterest's binaries and never go in the repo
fixtures/

# Local clones of the patch sources this bundle was assembled from (read, never committed).
# The ledger of those sources is the one file in there that is tracked.
/sources/*
!/sources/pinterest-sources.json

# Keep the selected marketing artwork with the project; assets/ holds what ships.

# Local working notes
CLAUDE.md
CODEX_CHANGELOG.md
.claude/
.mockups/

# Research notes (regenerated by research passes)
RESEARCH.md
Roadmap_Blocked.md

# Keep working and operations documents local; publish usage and release notes.
*.md
!README.md
!CHANGELOG.md
!docs/pinterest-14.39.0-factory-map.md
!docs/pinterest-14.39.0-audit.md
!docs/pinterest-14.39.0-ads.md
!docs/pinterest-14.39.0-privacy.md
!docs/pinterest-14.39.0-patch-reference.md
