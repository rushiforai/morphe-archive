<?xml version="1.0" encoding="utf-8"?>
<!--
  A test-only instrumentation that runs inside the patched PineDrama so device checks can reach
  HushPine's own settings. It has to be signed with the same key as the installed build, which
  is what lets the platform load it into that process. Never part of a release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.hushpine.verification">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <instrumentation
        android:name="app.hushpine.verification.Probe"
        android:targetPackage="com.ss.android.ttmd.video"
        android:label="HushPine verification probe" />

    <instrumentation
        android:name="app.hushpine.verification.StorageProbe"
        android:targetPackage="com.ss.android.ttmd.video"
        android:label="HushPine aggregate storage probe" />

    <application android:hasCode="true" android:label="HushPine verification probe">
        <!-- Runs as this APK's UID, never inside the instrumented target. Only shell/platform
             callers may start or stop the muted local fixture. It never restarts itself. -->
        <service
            android:name="app.hushpine.verification.FocusFixtureService"
            android:process=":audio_focus"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
