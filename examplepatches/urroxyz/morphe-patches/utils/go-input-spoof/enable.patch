+package xyz.urro.transit;
+
+import android.location.Location;
+import android.os.SystemClock;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class GoInputSpoof {
+    private static volatile boolean enabled = false;
+    private static volatile boolean boarded = false;
+    private static volatile int stopIndex = 0;
+    private static volatile List<double[]> routeCoordinates = new ArrayList<>();
+
+    public static synchronized void setEnabled(boolean e) {
+        enabled = e;
+        if (!e) {
+            boarded = false;
+            stopIndex = 0;
+        }
+    }
+
+    public static boolean isEnabled() {
+        return enabled;
+    }
+
+    public static synchronized void setBoarded(boolean b) {
+        boarded = b;
+    }
+
+    public static boolean isBoarded() {
+        return boarded;
+    }
+
+    public static synchronized void setRoute(List<double[]> coords) {
+        if (coords != null && !coords.isEmpty()) {
+            routeCoordinates = new ArrayList<>(coords);
+            stopIndex = 0;
+        }
+    }
+
+    public static synchronized int getStopIndex() {
+        return stopIndex;
+    }
+
+    public static synchronized int getStopCount() {
+        return routeCoordinates.size();
+    }
+
+    public static synchronized void previousStop() {
+        if (stopIndex > 0) {
+            stopIndex--;
+        }
+    }
+
+    public static synchronized void advanceStop() {
+        if (!routeCoordinates.isEmpty() && stopIndex < routeCoordinates.size() - 1) {
+            stopIndex++;
+        }
+    }
+
+    public static synchronized void alight() {
+        boarded = false;
+    }
+
+    public static void rewriteFix(Location loc) {
+        if (!enabled || loc == null) return;
+        double[] pt = getCurrentPoint();
+        if (pt == null) return;
+        loc.setLatitude(pt[0]);
+        loc.setLongitude(pt[1]);
+        loc.setTime(System.currentTimeMillis());
+        loc.setElapsedRealtimeNanos(SystemClock.elapsedRealtimeNanos());
+        loc.setAccuracy(5.0f);
+        if (boarded) {
+            loc.setSpeed(11.0f); // ~40 km/h in transit
+        } else {
+            loc.setSpeed(0.0f);
+        }
+    }
+
+    public static int[] motion(int[] current) {
+        if (!enabled || !boarded) return current;
+        // MLMotionType: Automotive = 5
+        return new int[]{5};
+    }
+
+    /**
+     * Loads stop coordinates from a native MapContent model (reflection only).
+     * Takes placemarks whose type is Stop, in list order. LatLng fields are obfuscated as a (lat) and b (lng).
+     */
+    private static boolean emptyLogged = false;
+
+    private static synchronized boolean sameRoute(List<double[]> stops) {
+        if (stops.size() != routeCoordinates.size()) return false;
+        for (int i = 0; i < stops.size(); i++) {
+            if (stops.get(i)[0] != routeCoordinates.get(i)[0] || stops.get(i)[1] != routeCoordinates.get(i)[1]) return false;
+        }
+        return true;
+    }
+
+    public static boolean loadFromMapContent(Object mapContent) {
+        GoActivityTransmitter.onMap(mapContent);
+        if (mapContent == null) return false;
+        try {
+            Object list = mapContent.getClass().getMethod("getPlacemarks").invoke(mapContent);
+            if (!(list instanceof Iterable)) return false;
+            List<double[]> stops = new ArrayList<>();
+            for (Object p : (Iterable<?>) list) {
+                Object type = p.getClass().getMethod("getType").invoke(p);
+                if (type == null || !"Stop".equals(((Enum<?>) type).name())) continue;
+                Object pos = p.getClass().getMethod("getPosition").invoke(p);
+                if (pos == null) continue;
+                double lat = pos.getClass().getField("a").getDouble(pos);
+                double lng = pos.getClass().getField("b").getDouble(pos);
+                stops.add(new double[]{lat, lng});
+            }
+            if (stops.isEmpty()) {
+                if (!emptyLogged) { emptyLogged = true; android.util.Log.i("TransitMorphe", "spoof_route_empty placemarks=" + ((Iterable<?>) list).iterator().hasNext()); }
+                return false;
+            }
+            if (sameRoute(stops)) return true; // map refreshes must not reset the stop index
+            setRoute(stops);
+            android.util.Log.i("TransitMorphe", "spoof_route_loaded stops=" + stops.size());
+            GoModelDiagnostics.trace("spoof_route_loaded", "stops=" + stops.size());
+            return true;
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            return false;
+        }
+    }
+
+    /**
+     * Inspects any generic model to extract Stop coordinates or placemarks if present.
+     */
+    public static boolean inspectModelForStops(Object model) {
+        if (model == null) return false;
+        try {
+            // If the model has getPlacemarks directly
+            if (loadFromMapContent(model)) return true;
+            // Or getMapContent
+            try {
+                Object mc = model.getClass().getMethod("getMapContent").invoke(model);
+                if (mc != null && loadFromMapContent(mc)) return true;
+            } catch (NoSuchMethodException ignored) {}
+            // Or getMapSummary -> getMapContent
+            try {
+                Object ms = model.getClass().getMethod("getMapSummary").invoke(model);
+                if (ms != null) {
+                    Object mc = ms.getClass().getMethod("getMapContent").invoke(ms);
+                    if (mc != null && loadFromMapContent(mc)) return true;
+                }
+            } catch (NoSuchMethodException ignored) {}
+        } catch (Exception ignored) {}
+        return false;
+    }
+
+    private static synchronized double[] getCurrentPoint() {
+        if (routeCoordinates.isEmpty()) return null;
+        int idx = Math.min(stopIndex, routeCoordinates.size() - 1);
+        return routeCoordinates.get(idx);
+    }
+}
