# Build artefacts
*.apk
*.idsig
*.dex
*.jar
# the wrapper jar is source, not an artefact
!gradle/wrapper/gradle-wrapper.jar
*.zip
*.tar.gz
build/
out/

# Private key that signs the patch bundle
morphe-signing.key

# Gradle / Node (the Morphe bundle)
.gradle/
*.mpp
node_modules/

# Tool bootstrap output and disassembly trees, generated by scripts/bootstrap.sh
# and scripts/decompile.sh (anchored so they cannot swallow a source directory
# such as analysis/tools/).
/tools/
/decoded/

# Local keystore / secrets — never commit a signing key
*.jks
*.keystore
*.p12
keystore.properties

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
