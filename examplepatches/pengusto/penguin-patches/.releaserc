{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
        "@semantic-release/commit-analyzer", {
        "releaseRules": [
            { "type": "fix", "release": "patch" },
            { "type": "feat", "release": "minor" },
            { "type": "bump", "release": "patch" },
            { "type": "perf", "release": "patch" },
            { "type": "build", "scope": "Needs bump", "release": "patch" }
        ]
        }
    ],
    [
        "@semantic-release/release-notes-generator", {
        "preset": "conventionalcommits",
        "presetConfig": {
            "types": [
                { "type": "fix", "section": "🐛 Bug Fixes", "hidden": false },
                { "type": "feat", "section": "✨ New Features", "hidden": false },
                { "type": "bump", "section": "🚀 Updated App Support", "hidden": false },
                { "type": "perf", "section": "🔧 Improvements",  "hidden": false },
                { "type": "build", "hidden": true }
            ]
        }
        }
    ],
    [
      "@MorpheApp/changelog", {
        "releaseJson": {
          "path": "patches-bundle.json",
          "downloadUrlTemplate": "https://github.com/${owner}/${repo}/releases/download/v${version}/patches-${version}.mpp",
          "signatureUrlTemplate": ""
        }
      }
    ],
    "gradle-semantic-release-plugin",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew generatePatchesList && jq '.version=\"${nextRelease.version}\"' patches-list.json > patches-list.json.tmp && mv patches-list.json.tmp patches-list.json && python3 -B .github/scripts/split_bundles.py --bundle patches/build/libs/patches-${nextRelease.version}.mpp --version ${nextRelease.version} --metadata patches-bundle.json --output-dir patches/build/libs --metadata-dir bundles --d8 \"$ANDROID_HOME/build-tools/37.0.0/d8\" --android-jar \"$ANDROID_HOME/platforms/android-35/android.jar\" --classpath \"$MORPHE_DESKTOP_JAR\" --compact-classes patches/build/classes/kotlin/main && python3 -B .github/scripts/verify_split_bundles.py --full patches/build/libs/patches-${nextRelease.version}.mpp --standard patches/build/libs/patches-standard-${nextRelease.version}.mpp --finamp patches/build/libs/patches-finamp-${nextRelease.version}.mpp --finamp-individual patches/build/libs/patches-finamp-individual-${nextRelease.version}.mpp --combined patches/build/libs/patches-combined-${nextRelease.version}.mpp --compact-classes patches/build/classes/kotlin/main && python3 -B tests/finamp/verify_compact.py --java \"$JAVA_HOME/bin/java\" --desktop \"$MORPHE_DESKTOP_JAR\" --bundle patches/build/libs/patches-finamp-${nextRelease.version}.mpp --original-apk \"$FINAMP_ORIGINAL_APK\" --work-dir \"$RUNNER_TEMP/finamp-compact-check\" && python3 -B tests/finamp/verify_compact.py --java \"$JAVA_HOME/bin/java\" --desktop \"$MORPHE_DESKTOP_JAR\" --bundle patches/build/libs/patches-combined-${nextRelease.version}.mpp --original-apk \"$FINAMP_ORIGINAL_APK\" --work-dir \"$RUNNER_TEMP/finamp-combined-check\" && python3 -B tests/finamp/validate_bundle.py --bundle patches/build/libs/patches-${nextRelease.version}.mpp --original-apk \"$FINAMP_ORIGINAL_APK\" --source-matrix tests/finamp/native-sources.json --report \"$RUNNER_TEMP/finamp-native-release-verification.json\" && python3 -B tests/mihon/check_evidence.py && python3 -B -m unittest discover -s tests/mihon -p 'test_*.py' -q && python3 -B tests/mihon/validate_bundle.py --bundle patches/build/libs/patches-${nextRelease.version}.mpp --original-apk \"$MIHON_ORIGINAL_APK\" --desktop \"$MORPHE_DESKTOP_JAR\" --report \"$RUNNER_TEMP/mihon-release-verification.json\" && python3 -B tests/calendar/validate_bundle.py --bundle patches/build/libs/patches-${nextRelease.version}.mpp --original-120 \"$CALENDAR_ORIGINAL_120\" --original-121 \"$CALENDAR_ORIGINAL_121\" --original-122 \"$CALENDAR_ORIGINAL_122\" --desktop \"$MORPHE_DESKTOP_JAR\" --report \"$RUNNER_TEMP/calendar-release-verification.json\" && mv patches/build/libs/patches-${nextRelease.version}.mpp \"$RUNNER_TEMP/penguin-full-validation.mpp\" && cp patches/build/libs/patches-combined-${nextRelease.version}.mpp patches/build/libs/patches-${nextRelease.version}.mpp && ./gradlew :patches:generatePatchesListFromBundle -PpatchListBundle=patches/build/libs/patches-${nextRelease.version}.mpp && python3 -B .github/scripts/finamp_catalogue.py --metadata patches-list.json && python3 .github/scripts/generate_patches_readme.py \"$GITHUB_REPOSITORY\" \"$GITHUB_REF_NAME\" patches-list.json README.md && python3 -B .github/scripts/sync_finamp_readme_locales.py && python3 -B -m unittest discover -s .github/scripts -p 'test_*.py' -q && python3 -B tests/finamp/validate_bundle.py --bundle patches/build/libs/patches-finamp-individual-${nextRelease.version}.mpp --original-apk \"$FINAMP_ORIGINAL_APK\" --source-matrix tests/finamp/native-sources.json --report \"$RUNNER_TEMP/finamp-final-release-verification.json\" && sha256sum patches/build/libs/patches-combined-${nextRelease.version}.mpp patches/build/libs/patches-finamp-individual-${nextRelease.version}.mpp > \"$RUNNER_TEMP/penguin-release-assets.sha256\"",
        "publishCmd": "sha256sum -c \"$RUNNER_TEMP/penguin-release-assets.sha256\" >&2 && mv -f patches/build/libs/patches-combined-${nextRelease.version}.mpp patches/build/libs/patches-${nextRelease.version}.mpp && python3 -B tests/finamp/verify_compact.py --java \"$JAVA_HOME/bin/java\" --desktop \"$MORPHE_DESKTOP_JAR\" --bundle patches/build/libs/patches-${nextRelease.version}.mpp --original-apk \"$FINAMP_ORIGINAL_APK\" --work-dir \"$RUNNER_TEMP/finamp-combined-final\" >&2 && python3 -B tests/finamp/verify_compact.py --java \"$JAVA_HOME/bin/java\" --desktop \"$MORPHE_DESKTOP_JAR\" --bundle patches/build/libs/patches-finamp-${nextRelease.version}.mpp --original-apk \"$FINAMP_ORIGINAL_APK\" --work-dir \"$RUNNER_TEMP/finamp-compact-final\" >&2 && python3 -B tests/mihon/validate_bundle.py --bundle patches/build/libs/patches-${nextRelease.version}.mpp --original-apk \"$MIHON_ORIGINAL_APK\" --desktop \"$MORPHE_DESKTOP_JAR\" --report \"$RUNNER_TEMP/mihon-final-release-verification.json\" >&2 && python3 -B tests/calendar/validate_bundle.py --bundle patches/build/libs/patches-${nextRelease.version}.mpp --original-120 \"$CALENDAR_ORIGINAL_120\" --original-121 \"$CALENDAR_ORIGINAL_121\" --original-122 \"$CALENDAR_ORIGINAL_122\" --desktop \"$MORPHE_DESKTOP_JAR\" --report \"$RUNNER_TEMP/calendar-final-release-verification.json\" >&2"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "gradle.properties",
          "patches-bundle.json",
          "bundles/standard/patches-bundle.json",
          "bundles/finamp/patches-bundle.json",
          "bundles/finamp-individual/patches-bundle.json",
          "patches-list.json",
          "README.md",
          "docs/readme/README.*.md"
        ],
        "message": "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "patches/build/libs/patches-!(*sources*|*javadoc*).mpp?(.asc)"
          }
        ],
        "successComment": false
      }
    ],
    [
      "@cleyrop-org/semantic-release-backmerge",
      {
        "backmergeBranches": [{"from": "main", "to": "dev"}],
        "clearWorkspace": true
      }
    ]
  ]
}
