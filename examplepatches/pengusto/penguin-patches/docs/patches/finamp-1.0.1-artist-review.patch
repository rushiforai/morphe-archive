+          ),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+    await tester.tap(find.byIcon(TablerIcons.download));
+    await tester.pumpAndSettle();
+    expect(tester.widget<DownloadDialog>(find.byType(DownloadDialog)).trackCount, 4);
+  });
+}
