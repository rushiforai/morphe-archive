#!/usr/bin/env bash
set -e
hook=$(basename "$0")
if [[ "$hook" == pre-commit ]]; then
  python3 .github/scripts/check_android_regex.py --staged
fi
global_dir="$(git config --global --get core.hooksPath || true)"
if [[ -n "$global_dir" && -x "$global_dir/$hook" && ! "$global_dir/$hook" -ef "$0" ]]; then
  exec "$global_dir/$hook" "$@"
fi
