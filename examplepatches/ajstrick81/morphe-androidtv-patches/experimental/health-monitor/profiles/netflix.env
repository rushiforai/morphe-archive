# Netflix clone (com.netflix.ninja.clone) — Health Monitor profile.
#
# Validates the 2026-09-13 experimental MASTER wildcard-drift fix (issue #166).
# Netflix re-minified the appboot JS: getAdMetadata's exact anchor drifted
# (if(d)->if(e), plus an added `else if(adverts.adBreaks.length)` middle branch and
# a newline before the enrich chain), so the exact patchMASTER scan-missed and ads
# leaked (KILLMARK=0 while rawRealPods>0). The new killads.js adds an ATOMIC,
# rename-tolerant wildcard fallback (patchMASTERw) that re-anchors getAdMetadata by
# its stable API tokens (getAds / adBreakHydrator) and applies if(0)+`else b=[]`
# together (never M1 alone -> no v1 crash). On-device the fallback fires as
# "PATCH MASTERw: ... (atomic, rename-tolerant) — string-drift recovered".
#
# The ad-kill runs in-process (frida-gadget script mode) and logs to tag KILL, so
# the healthy/leak signatures below come from that oracle, not the app's own logs.
PKG=com.netflix.ninja.clone

# ATTACH: monitor the title already playing — do NOT relaunch or blind-navigate.
# (The clone signs in via the shared com.netflix.tokenmanager and survives pm clear;
#  a title is resumed by hand, then this babysits it. Netflix ATV deep links are not
#  a safe rotation vector here, so single-title attach only.)
LAUNCH=attach

# media_session publishes an advancing position during real playback.
PLAYBACK_PROBE=position

# No rotation / no stress nav in attach mode (hard rule: the TV is a surface we
# cannot see; only the human switches titles). Tick often enough to catch a
# pre/mid-roll window.
TICK_SECS=20
STRESS_EVERY_MIN=0

# HEALTHY ad-defense signatures from the KILL oracle: the wildcard MASTER re-anchor
# landing, the legacy/DAI source kills, and a manifest ad-break being emptied.
SUPPRESS_RE="PATCH MASTERw|PATCH MASTER:|PATCH A2|PATCH DAI|PATCH ADV|<<<MANIFEST-KILL"

# HARD LEAK: the oracle's own drift alarm — raw ad pods resident with nothing killed
# (rawRealPods>0 & KILLMARK=0). If MASTERw ever misses again this fires immediately.
# (server-pauseAd is the pause-overlay ad; also a leak worth flagging.)
AD_LEAK_RE="<<<DRIFT|MASTERw M2-MISS|<<<server-pauseAd"

# Netflix native/JS stack: catch self-kill (SIG 9 / has died), native crashes, ANRs.
ERROR_RE="FATAL|ANR in com.netflix.ninja.clone|SIGABRT|SIGSEGV|has died|Sending signal. PID"

SERIAL=192.168.12.211:5555
