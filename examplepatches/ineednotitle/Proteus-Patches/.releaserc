{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
        "@semantic-release/commit-analyzer", {
        "releaseRules": [
            { "type": "fix", "release": "patch" },
            { "type": "feat", "release": "minor" },
            { "type": "bump", "release": "patch" },
            { "type": "perf", "release": "patch" },
            { "type": "build", "scope": "Needs bump", "release": "patch" }
        ]
        }
    ],
    [
        "@semantic-release/release-notes-generator", {
        "preset": "conventionalcommits",
        "presetConfig": {
            "types": [
                { "type": "fix", "section": "🐛 Bug Fixes", "hidden": false },
                { "type": "feat", "section": "✨ New Features", "hidden": false },
                { "type": "bump", "section": "🚀 Updated App Support", "hidden": false },
                { "type": "perf", "section": "🔧 Improvements",  "hidden": false },
                { "type": "build", "hidden": true }
            ]
        }
        }
    ],
    [
      "@MorpheApp/changelog", {
        "releaseJson": {
          "path": "patches-bundle.json",
          "downloadUrlTemplate": "https://github.com/${owner}/${repo}/releases/download/v${version}/patches-${version}.mpp",
          "signatureUrlTemplate": ""
        }
      }
    ],
    "gradle-semantic-release-plugin",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash .github/scripts/test_pinterest_video_urls.sh && ./gradlew :patches:testPermissionRemoval :patches:testBravePrivacy generatePatchesList \
          && python3 .github/scripts/verify_patch_source.py patches-bundle.json ${nextRelease.version} --normalize \
          && jq '.version=\"${nextRelease.version}\"' patches-list.json > patches-list.json.tmp && mv patches-list.json.tmp patches-list.json \
          && python3 .github/scripts/generate_patches_readme.py $GITHUB_REPOSITORY $GITHUB_REF_NAME patches-list.json README.md \
          && python3 .github/scripts/verify_android_bundle.py patches/build/libs/patches-${nextRelease.version}.mpp ${nextRelease.version} --patch-list patches-list.json"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "gradle.properties",
          "patches-bundle.json",
          "patches-list.json",
          "README.md"
        ],
        "message": "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "patches/build/libs/patches-!(*sources*|*javadoc*).mpp?(.asc)"
          }
        ],
        "successComment": false
      }
    ],
    [
      "@cleyrop-org/semantic-release-backmerge",
      {
        "backmergeBranches": [{"from": "main", "to": "dev"}],
        "clearWorkspace": true
      }
    ]
  ]
}
