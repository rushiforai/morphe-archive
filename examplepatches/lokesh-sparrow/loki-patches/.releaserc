#
# semantic-release configuration. Kept in YAML on purpose: it allows comments, and
# cosmiconfig loads a .releaserc without extension as YAML.
#
# A push to main is a release. The commit type decides the version bump; the prepared
# files (patches list, README table, bundle JSON, CHANGELOG) are committed by
# @semantic-release/git together with the version bump in gradle.properties.

branches:
  - main

plugins:
  # Which commits produce a release, and of what kind.
  - - "@semantic-release/commit-analyzer"
    - releaseRules:
        - type: fix
          release: patch
        - type: feat
          release: minor
        - type: bump
          release: patch
        - type: perf
          release: patch
        - type: build
          scope: Needs bump
          release: patch

  # Release notes in the Loki Patches format (### Fixes / - **App:** text / patch count). The same text
  # becomes the CHANGELOG entry, the description in patches-bundle.json and the GitHub release body.
  # The bundle is built first so the patch count in the last line is the released one; Gradle's
  # output goes to stderr because stdout is the notes.
  - - "@semantic-release/exec"
    - generateNotesCmd: >-
        ./gradlew generatePatchesList -q 1>&2
        && python3 .github/scripts/release_notes.py $GITHUB_REPOSITORY ${nextRelease.version} "${lastRelease.gitTag}"

  # patches-bundle.json is what the Morphe manager reads for updates.
  - - "@MorpheApp/changelog"
    - releaseJson:
        path: patches-bundle.json
        downloadUrlTemplate: https://github.com/${owner}/${repo}/releases/download/v${version}/patches-${version}.mpp
        signatureUrlTemplate: ""

  # Runs the Gradle build through the project's wrapper.
  - gradle-semantic-release-plugin

  # Everything generated from the patch bundle, regenerated before the release commit.
  - - "@semantic-release/exec"
    - prepareCmd: >-
        rm -f patches/build/libs/*.mpp
        && ./gradlew generatePatchesList -Pversion=${nextRelease.version} -PbundleVersion=${nextRelease.version}
        && rm -f patches/build/libs/*-sources.mpp patches/build/libs/*-javadoc.mpp
        && jq '.version="${nextRelease.version}"' patches-list.json > patches-list.json.tmp && mv patches-list.json.tmp patches-list.json
        && python3 .github/scripts/generate_patches_readme.py $GITHUB_REPOSITORY $GITHUB_REF_NAME patches-list.json README.md

  # The files the release commit carries. Never edit these by hand in a version commit.
  - - "@semantic-release/git"
    - assets:
        - CHANGELOG.md
        - gradle.properties
        - patches-bundle.json
        - patches-list.json
        - README.md
        - docs/apps/*.md
      message: "chore: Release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"

  # Publishes the release with the bundle, and nothing else.
  - - "@semantic-release/github"
    - assets:
        # Only the bundle this release built. The glob form attached every .mpp in the folder, so a
        # 3.1.0 build left from the pre-bump Gradle run shipped inside the 3.1.1 release too.
        # A glob, because @semantic-release/github does not interpolate ${nextRelease.version} here: it looked for
        # a file with that literal name, found none, and published 3.2.0 with no bundle at all. prepareCmd has
        # already deleted every other .mpp, so this matches exactly the bundle being released.
        - path: "patches/build/libs/patches-*.mpp"
      successComment: false
