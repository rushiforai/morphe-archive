<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="app.utsavrajput.extension.AboutActivity"
            android:exported="false" />
        <activity
            android:name="app.utsavrajput.extension.ToolsActivity"
            android:exported="false" />
    </application>

    <!--
    The 6 tool screens (Transfer Files, WhatsApp Status Saver, Playlist,
    Secure Folder, URL Stream, Recycle Bin) are no longer custom Activities
    in this module - ToolsActivity launches MX Player's own built-in
    feature Activities directly via explicit Intent (setClassName), since
    they already exist, working and pre-themed, in MX Player's own
    AndroidManifest.xml. See ToolsActivity.kt for the exact class names.

    NOTE: this manifest is NOT actually merged into MX Player's APK by
    extendWith() - see RegisterExtensionActivitiesPatch.kt, which injects
    the real <activity> entries directly into MX Player's own
    AndroidManifest.xml at patch time. This file is kept in sync purely for
    documentation/consistency.
    -->

</manifest>
