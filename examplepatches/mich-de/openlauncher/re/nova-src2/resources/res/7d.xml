<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="0x7f060131"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="22sp"
        android:textColor="0x7f060133"
        android:ellipsize="end"
        android:layout_gravity="start"
        android:id="0x7f0b0362"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="0x7f140356"
        android:maxLines="1"/>
    <TextView
        android:textSize="18sp"
        android:textColor="0x7f060132"
        android:ellipsize="end"
        android:layout_gravity="center_horizontal"
        android:id="0x7f0b0361"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="16dp"
        android:text="0x7f140355"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="16dp">
        <Button
            android:textStyle="bold"
            android:textColor="0x7f060130"
            android:ellipsize="end"
            android:id="0x7f0b0346"
            android:background="0x7f06012f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:text="0x7f140353"
            android:maxLines="1"
            android:textAllCaps="false"/>
        <Button
            android:textStyle="bold"
            android:textColor="0x7f060130"
            android:ellipsize="end"
            android:id="0x7f0b035f"
            android:background="0x7f06012f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0x7f140354"
            android:maxLines="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
