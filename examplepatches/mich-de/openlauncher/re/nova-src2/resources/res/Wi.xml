<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="0x7f0b0389"
            android:background="0x7f08014b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="4dp"
            android:elevation="4dp">
            <EditText
                android:textSize="15sp"
                android:textColor="0x7f06003f"
                android:textColorHint="0x7f060048"
                android:id="0x7f0b014a"
                android:background="@android:color/transparent"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="0x7f070051"
                android:hint="0x7f14008b"
                android:maxLines="12"
                android:layout_weight="1"
                android:inputType="textMultiLine"
                android:imeOptions="actionSend"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <ImageButton
                android:enabled="false"
                android:id="0x7f0b014c"
                android:background="0x7f080185"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="0x7f080171"
                android:scaleType="center"
                android:contentDescription="0x7f1400f1"
                android:alpha="0x7f070052"/>
        </LinearLayout>
    </LinearLayout>
</merge>
