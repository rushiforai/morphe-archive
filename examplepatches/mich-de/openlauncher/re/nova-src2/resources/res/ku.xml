<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="0x7f060036"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="0x7f060048"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="0x7f06005d"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0x7f1400b0"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="0x7f0b040d"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="0x7f0b040f"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="0x7f060035"/>
    <TextView
        android:textSize="14sp"
        android:textColor="0x7f060048"
        android:gravity="center"
        android:id="0x7f0b040e"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0x7f1400af"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="0x7f0b06ea"
        android:background="0x7f080191"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f080174"
            app:tint="@android:color/black"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:id="0x7f0b06eb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0x7f14010f"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
