<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="64dp"
    android:paddingEnd="16dp">
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.instabridge.ai.chat.ui.InteractiveChatTextView
            android:textSize="15sp"
            android:textColor="0x7f06005f"
            android:textColorHighlight="0x7f06005c"
            android:textColorLink="0x7f060046"
            android:id="0x7f0b06f3"
            android:background="0x7f08014d"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="0x7f060048"
            android:layout_gravity="end"
            android:id="0x7f0b06f4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
</FrameLayout>
