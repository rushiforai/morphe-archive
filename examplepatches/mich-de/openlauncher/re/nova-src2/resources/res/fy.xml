<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="48dp"
    app:cardBackgroundColor="0x7f060036"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="0x7f060044"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.instabridge.ai.chat.ui.InteractiveChatTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="0x7f06003f"
            android:textColorHighlight="0x7f06005c"
            android:textColorLink="0x7f060046"
            android:id="0x7f0b0148"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="0x7f0b01f9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
