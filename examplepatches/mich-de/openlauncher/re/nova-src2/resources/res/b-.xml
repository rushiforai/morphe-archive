<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="48dp"
    app:cardBackgroundColor="0x7f060036"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="0x7f060044"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f080155"
                android:contentDescription="@null"/>
            <com.instabridge.ai.chat.ui.InteractiveChatTextView
                android:textSize="14sp"
                android:textColor="0x7f060052"
                android:textColorHighlight="0x7f06005c"
                android:textColorLink="0x7f060046"
                android:id="0x7f0b003f"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <com.instabridge.ai.chat.ui.InteractiveChatTextView
            android:textSize="16sp"
            android:textColor="0x7f06003f"
            android:textColorHighlight="0x7f06005c"
            android:textColorLink="0x7f060046"
            android:id="0x7f0b0407"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="0x7f0b011e"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <Button
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:id="0x7f0b018f"
                android:background="0x7f080147"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="0x7f140100"
                android:layout_weight="1"
                android:textAllCaps="false"/>
            <View
                android:layout_width="8dp"
                android:layout_height="0dp"/>
            <Button
                android:textSize="14sp"
                android:textColor="0x7f06003f"
                android:id="0x7f0b012a"
                android:background="0x7f080148"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="0x7f1400fd"
                android:layout_weight="1"
                android:textAllCaps="false"/>
        </LinearLayout>
        <com.instabridge.ai.chat.ui.InteractiveChatTextView
            android:textSize="13sp"
            android:textColorHighlight="0x7f06005c"
            android:textColorLink="0x7f060046"
            android:id="0x7f0b0184"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
