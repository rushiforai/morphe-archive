<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="0x7f0801a1"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="0x7f060084"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0x7f140102"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"/>
    </LinearLayout>
    <com.instabridge.ai.chat.ui.InteractiveChatTextView
        android:textSize="15.5sp"
        android:textColor="0x7f060085"
        android:textColorHighlight="0x7f06005c"
        android:textColorLink="0x7f060046"
        android:id="0x7f0b0536"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.3"
        android:textIsSelectable="true"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01"/>
    <com.google.android.flexbox.FlexboxLayout
        android:id="0x7f0b0158"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:alignItems="0"
        app:flexWrap="1"
        app:justifyContent="0"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="0x7f0b01d8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <EditText
            android:textSize="14sp"
            android:textColor="0x7f06007d"
            android:textColorHint="0x7f06007c"
            android:id="0x7f0b01d7"
            android:background="0x7f0801a4"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="0x7f140107"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
        <ImageButton
            android:id="0x7f0b05c5"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="0x7f080171"
            android:contentDescription="0x7f1400f1"
            android:layout_marginStart="8dp"
            app:tint="0x7f060060"/>
    </LinearLayout>
    <TextView
        android:textSize="12.5sp"
        android:textColor="0x7f06008d"
        android:id="0x7f0b0601"
        android:padding="4dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="0x7f140104"
        android:fontFamily="sans-serif-medium"/>
    <com.instabridge.ai.chat.ui.InteractiveChatTextView
        android:textSize="13sp"
        android:textColor="0x7f060088"
        android:textColorHighlight="0x7f06005c"
        android:textColorLink="0x7f060046"
        android:id="0x7f0b0184"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textIsSelectable="true"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
