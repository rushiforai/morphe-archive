<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="0x7f0801a1"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp">
    <com.instabridge.ai.chat.ui.InteractiveChatTextView
        android:textSize="15.5sp"
        android:textColor="0x7f060085"
        android:textColorHighlight="0x7f06005c"
        android:textColorLink="0x7f060046"
        android:id="0x7f0b0148"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.3"
        android:textIsSelectable="true"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="0x7f0b01f9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
</LinearLayout>
