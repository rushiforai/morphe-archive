<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="0x7f0b0715"
        android:background="0x7f08019e"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">
        <ImageView
            android:id="0x7f0b0714"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="0x7f0802d5"
            android:contentDescription="@null"
            android:layout_marginEnd="8dp"
            app:tint="0x7f06007b"/>
        <TextView
            android:textSize="12.5sp"
            android:textColor="0x7f06007b"
            android:id="0x7f0b0717"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.25"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"/>
        <TextView
            android:textSize="12.5sp"
            android:textColor="0x7f06007a"
            android:id="0x7f0b0716"
            android:padding="4dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0x7f140118"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
</FrameLayout>
