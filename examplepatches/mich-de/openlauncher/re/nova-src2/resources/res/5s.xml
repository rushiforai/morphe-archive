<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="0x7f01005d"
        android:duration="2000"
        android:repeatCount="infinite"
        android:repeatMode="restart"
        android:valueFrom="1"
