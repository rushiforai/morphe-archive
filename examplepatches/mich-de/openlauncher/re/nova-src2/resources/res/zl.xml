<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="0dp"
    android:paddingTop="4dp"
    android:paddingRight="0dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="0x7f0b06ad"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:showDividers="middle"
        android:dividerPadding="16dp">
        <TextView
            android:gravity="center_vertical"
            android:id="0x7f0b021e"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:text="0x7f14026d"
            android:layout_weight="1"
            style="0x7f15028d"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="0x7f0b03fb"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="0x7f08038b"
            android:scaleType="centerInside"
            android:contentDescription="0x7f14003d"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="0x7f0b06a7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="0x7f140ba0"
            android:layout_weight="1"
            android:inputType="textCapWords"
            android:imeOptions="actionDone"
            android:textDirection="anyRtl"
            android:importantForAutofill="no">
            <requestFocus/>
        </EditText>
        <com.teslacoilsw.launcher.preferences.fancyprefs.FancyPrefColorView
            android:id="0x7f0b0174"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_weight="0"
            app:canAlpha="false"
            app:canManagedByNova="true"/>
    </LinearLayout>
    <Spinner
        android:layout_gravity="center"
        android:id="0x7f0b06da"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="180dp"
        android:layout_height="wrap_content"/>
    <com.teslacoilsw.launcher.widget.NovaCheckBox
        android:id="0x7f0b0397"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:checked="true"
        android:text="0x7f1403a0"
        android:paddingEnd="8dp"
        style="0x7f1503f3"/>
</LinearLayout>
