<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="0x7f08019b"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">
    <TextView
        android:textSize="11.5sp"
        android:textColor="0x7f060061"
        android:id="0x7f0b070f"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:layout_marginEnd="10dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="13.5sp"
            android:textColor="0x7f06007d"
            android:ellipsize="end"
            android:id="0x7f0b0710"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"/>
        <TextView
            android:textSize="11.5sp"
            android:textColor="0x7f06007f"
            android:ellipsize="end"
            android:id="0x7f0b070e"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:id="0x7f0b070d"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="0x7f0802d1"
        android:contentDescription="@null"
        android:layout_marginStart="8dp"
        app:tint="0x7f06007f"/>
</LinearLayout>
