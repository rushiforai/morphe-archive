<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="0x7f06004b"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="0x7f150368"
        android:id="0x7f0b052b"
        android:background="0x7f06004b"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="0x7f0b0529"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="48dp"
        android:indeterminateTint="0x7f060035"/>
    <TextView
        android:textSize="14sp"
        android:textColor="0x7f060048"
        android:gravity="center"
        android:id="0x7f0b0528"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="0x7f1400ce"/>
    <ScrollView
        android:id="0x7f0b052a"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="0x7f06005d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0x7f1400e0"/>
            <TextView
                android:textSize="14sp"
                android:textColor="0x7f060052"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0x7f1400df"/>
            <FrameLayout
                android:id="0x7f0b0035"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"/>
            <FrameLayout
                android:id="0x7f0b064a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <FrameLayout
                android:id="0x7f0b019a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="0x7f060052"
                    android:id="0x7f0b02f4"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x7f1400cd"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="0x7f060052"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:paddingHorizontal="4dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="0x7f060052"
                    android:id="0x7f0b02f3"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x7f1400cc"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
