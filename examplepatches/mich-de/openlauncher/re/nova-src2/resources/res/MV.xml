<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="0x7f0801a1"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp">
    <com.instabridge.ai.chat.ui.InteractiveChatTextView
        android:textSize="12sp"
        android:textColor="0x7f060084"
        android:textColorHighlight="0x7f06005c"
        android:textColorLink="0x7f060046"
        android:id="0x7f0b003f"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textIsSelectable="true"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"/>
    <com.instabridge.ai.chat.ui.InteractiveChatTextView
        android:textSize="15.5sp"
        android:textColor="0x7f060085"
        android:textColorHighlight="0x7f06005c"
        android:textColorLink="0x7f060046"
        android:id="0x7f0b0407"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.3"
        android:textIsSelectable="true"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="0x7f0b011e"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <Button
            android:textSize="14sp"
            android:textColor="0x7f06008a"
            android:id="0x7f0b018f"
            android:background="0x7f0801a3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="0x7f140100"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"/>
        <View
            android:layout_width="8dp"
            android:layout_height="0dp"/>
        <Button
            android:textSize="14sp"
            android:textColor="0x7f060081"
            android:id="0x7f0b012a"
            android:background="0x7f0801a0"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="0x7f1400fd"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"/>
    </LinearLayout>
    <com.instabridge.ai.chat.ui.InteractiveChatTextView
        android:textSize="13sp"
        android:textColorHighlight="0x7f06005c"
        android:textColorLink="0x7f060046"
        android:id="0x7f0b0184"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textIsSelectable="true"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
