<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="0x7f08017f"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="0x7f06005d"
                android:id="0x7f0b04db"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="0x7f060034"
                android:id="0x7f0b04d9"
                android:background="0x7f08017b"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7f1400ae"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="0x7f060052"
            android:id="0x7f0b04dc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <ImageView
        android:id="0x7f0b04da"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="0x7f080163"
        android:layout_marginStart="12dp"/>
    <Button
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="0x7f06005d"
        android:id="0x7f0b04dd"
        android:background="0x7f080180"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="0x7f1400be"
        android:textAllCaps="false"
        android:layout_marginStart="12dp"
        android:paddingHorizontal="16dp"/>
</LinearLayout>
