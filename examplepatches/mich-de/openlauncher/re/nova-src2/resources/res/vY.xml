<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.widget.picker.WidgetsListHeader xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="0x7f0b076d"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="0x7f070554"
    launcher:appIconSize="48dp">
    <ImageView
        android:id="0x7f0b00ac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="0x7f0b00ab"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="0x7f0b00b2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="end"
            android:id="0x7f0b00b1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:alpha="0.7"/>
    </LinearLayout>
    <CheckBox
        android:enabled="false"
        android:layout_gravity="center_vertical"
        android:id="0x7f0b06b9"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="0x7f0806c9"
        android:importantForAccessibility="no"
        android:layout_alignParentEnd="true"
        android:layout_marginHorizontal="16dp"/>
</com.android.launcher3.widget.picker.WidgetsListHeader>
