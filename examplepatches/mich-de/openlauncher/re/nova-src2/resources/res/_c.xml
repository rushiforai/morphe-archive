<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="0x7f08017f"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f080167"
            android:importantForAccessibility="no"
            app:tint="0x7f060052"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="0x7f06005d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0x7f1400de"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="12sp"
                android:textColor="0x7f060052"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7f1400ca"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="0x7f06005d"
                android:id="0x7f0b04e1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:id="0x7f0b0634"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="0x7f06004a"
        android:id="0x7f0b0635"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="0x7f0b0218"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="0x7f080164"
            android:importantForAccessibility="no"
            app:tint="0x7f060052"/>
        <TextView
            android:textSize="13sp"
            android:textColor="0x7f060052"
            android:id="0x7f0b0217"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="0x7f06005d"
            android:id="0x7f0b0219"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="12sp"
            android:textColor="0x7f060052"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0x7f1400e2"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="0x7f06005d"
            android:id="0x7f0b06ef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="0x7f060052"
            android:id="0x7f0b06f0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="0x7f0b003c"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
</LinearLayout>
