<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="0x7f06005d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7f1400d4"/>
            <TextView
                android:textSize="13sp"
                android:textColor="0x7f060052"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0x7f1400d3"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat
            android:id="0x7f0b03da"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="0x7f08018b"
            app:track="0x7f08018c"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="0x7f0b04b5"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="0x7f060052"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="0x7f1400c9"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="0x7f060035"
                android:id="0x7f0b0093"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7f1400c4"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="0x7f060052"
                android:id="0x7f0b0092"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7f1400c3"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="0x7f0b06bc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</LinearLayout>
