<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:duration="4000"
        android:repeatCount="infinite"
        android:repeatMode="reverse">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="translateX">
            <keyframe
                android:value="0"
                android:fraction="0"/>
            <keyframe
                android:value="-8"
                android:fraction="0.2"/>
            <keyframe
                android:value="0"
                android:fraction="0.4"/>
            <keyframe
                android:value="8"
                android:fraction="0.6"/>
            <keyframe
                android:value="0"
                android:fraction="0.8"/>
            <keyframe
                android:value="-8"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:duration="4000"
        android:repeatCount="infinite"
        android:repeatMode="reverse">
        <propertyValuesHolder
            android:valueType="floatType"
            android:propertyName="translateY">
            <keyframe
                android:value="0"
                android:fraction="0"/>
            <keyframe
                android:value="2"
                android:fraction="0.2"/>
            <keyframe
                android:value="-2"
                android:fraction="0.4"/>
            <keyframe
                android:value="0"
                android:fraction="0.6"/>
            <keyframe
                android:value="1"
                android:fraction="0.8"/>
            <keyframe
                android:value="2"
                android:fraction="1"/>
        </propertyValuesHolder>
    </objectAnimator>
</set>
