<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="0dp"
    android:paddingTop="4dp"
    android:paddingRight="0dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center_vertical"
        android:id="0x7f0b021d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="8dp"
        android:text="0x7f140952"
        style="0x7f150284"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp">
        <TextView
            android:textColor="#fff0f0f0"
            android:ellipsize="none"
            android:gravity="start|top"
            android:id="0x7f0b0647"
            android:background="#ff0a0a0a"
            android:scrollbars="vertical|horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="256dp"
            android:scrollHorizontally="true"
            android:fontFamily="monospace"
            style="0x7f150284"/>
    </LinearLayout>
    <com.teslacoilsw.launcher.widget.NovaCheckBox
        android:id="0x7f0b0554"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:checked="false"
        android:text="0x7f1408b5"
        style="0x7f1503f3"/>
</LinearLayout>
