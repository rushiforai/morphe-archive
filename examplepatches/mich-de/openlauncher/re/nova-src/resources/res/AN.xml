<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="0x7f060036"
    android:paddingBottom="32dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="0x7f060048"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="0x7f06005d"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0x7f1400bf"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="0x7f080150"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="0x7f06005d"
            android:gravity="center"
            android:id="0x7f0b0419"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="0x7f1400bd"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="0x7f060052"
            android:gravity="center"
            android:id="0x7f0b00a5"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="0x7f1400bb"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="0x7f0b04de"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="0x7f0b04e0"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="0x7f060035"/>
    <TextView
        android:textSize="14sp"
        android:textColor="0x7f060048"
        android:gravity="center"
        android:id="0x7f0b04df"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
