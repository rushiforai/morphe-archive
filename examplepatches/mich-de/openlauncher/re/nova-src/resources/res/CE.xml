<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0x7f07016d">
        <Button
            android:textSize="0x7f070191"
            android:textStyle="normal"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="0x7f0b0342"
            android:background="0x7f0802a4"
            android:paddingLeft="0x7f07016c"
            android:paddingTop="0x7f07016e"
            android:paddingRight="0x7f07016c"
            android:paddingBottom="0x7f07016e"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0x7f070188"
            android:minHeight="1dp"
            android:maxLines="1"
            android:lineSpacingMultiplier="1.38"
            android:textAllCaps="false"
            android:letterSpacing="0.04"/>
    </LinearLayout>
    <TextView
        android:layout_gravity="bottom|right"
        android:id="0x7f0b034a"
        android:layout_margin="12dp"
        style="0x7f150571"/>
</FrameLayout>
