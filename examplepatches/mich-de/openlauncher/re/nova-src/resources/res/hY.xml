<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="0x7f08017f"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="0x7f080177"
            android:importantForAccessibility="no"
            app:tint="0x7f060052"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="0x7f06005d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0x7f1400c2"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="0x7f0b0036"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="0x7f0b043d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:background="0x7f08017e"
                android:layout_width="40dp"
                android:layout_height="40dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="0x7f06005d"
                    android:layout_gravity="center"
                    android:id="0x7f0b00c9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="0x7f060052"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x7f1400d1"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="0x7f06005d"
                    android:id="0x7f0b043e"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="0x7f0b026b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <FrameLayout
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="0x7f08016d"
                    android:importantForAccessibility="no"
                    app:tint="0x7f060052"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="0x7f060052"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x7f1400cb"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="0x7f06005d"
                    android:id="0x7f0b026c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <FrameLayout
                android:gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="0x7f080173"
                    android:importantForAccessibility="no"
                    app:tint="0x7f060052"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="0x7f060052"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x7f1400c1"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="0x7f06005d"
                    android:id="0x7f0b0034"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="0x7f0b0033"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="0x7f060052"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0x7f1400d9"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="0x7f06005d"
            android:id="0x7f0b05ff"
            android:background="0x7f080180"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="0x7f1400d8"
            android:textAllCaps="false"
            android:paddingHorizontal="24dp"/>
    </LinearLayout>
</LinearLayout>
