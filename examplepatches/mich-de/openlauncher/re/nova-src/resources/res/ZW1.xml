<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="0x7f0b01a5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.teslacoilsw.launcher.widget.RippleScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="0x7f1403b2"/>
            <Button
                android:id="0x7f0b04e2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7f1407b6"
                android:drawableLeft="0x7f0802c4"
                android:drawablePadding="8dp"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:paddingTop="64dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="0x7f1403b1"/>
            <AutoCompleteTextView
                android:id="0x7f0b06f5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:hint="0x7f140b92"
                android:maxLines="1"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"/>
            <EditText
                android:id="0x7f0b016d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:hint="0x7f140b8d"
                android:maxLines="1"
                android:inputType="textVisiblePassword"
                android:imeOptions="actionGo"
                android:autofillHints="password"/>
        </LinearLayout>
    </com.teslacoilsw.launcher.widget.RippleScrollView>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0">
        <Button
            android:gravity="center"
            android:layout_gravity="center"
            android:id="0x7f0b02f8"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:text="0x7f140303"/>
        <Button
            android:gravity="center"
            android:layout_gravity="center"
            android:id="0x7f0b0484"
            android:padding="10dp"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:text="0x7f14074e"/>
    </LinearLayout>
</LinearLayout>
