<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="0x7f0b04fc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="0x7f060052"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="0x7f1400f4"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:id="0x7f0b010f"
            android:background="0x7f080186"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="0x7f1400f2"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            app:backgroundTint="@null"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="0x7f0b04f6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="0x7f060052"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="0x7f1400f8"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="0x7f080187"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">
            <TextView
                android:textSize="13sp"
                android:textColor="0x7f06003f"
                android:ellipsize="middle"
                android:id="0x7f0b06d6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageButton
                android:id="0x7f0b010d"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="0x7f080166"
                android:contentDescription="0x7f1400f3"/>
        </LinearLayout>
        <Button
            android:textSize="15sp"
            android:textColor="0x7f06003f"
            android:id="0x7f0b0110"
            android:background="0x7f080187"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="0x7f1400f9"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            app:backgroundTint="@null"/>
        <Button
            android:textSize="15sp"
            android:textColor="0x7f060052"
            android:id="0x7f0b010e"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="0x7f1400f5"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            app:backgroundTint="@null"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="0x7f0b052c"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
