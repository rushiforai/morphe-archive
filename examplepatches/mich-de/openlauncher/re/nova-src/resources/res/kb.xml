<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="0x7f0b0479"
    android:background="0x7f0603ec"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:background="0x7f080527"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="420dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">
                <TextView
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="0x7f06005d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0x7f14065b"
                    android:textAlignment="center"
                    android:letterSpacing="0.02"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="0x7f06003f"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="0x7f14065c"
                    android:lineSpacingMultiplier="1.25"
                    android:textAlignment="center"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="0x7f06005d"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="0x7f14065e"
                    android:textAllCaps="false"
                    android:textAlignment="center"
                    android:letterSpacing="0.04"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="0x7f060052"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0x7f14065d"
                    android:lineSpacingMultiplier="1.25"
                    android:textAlignment="center"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:id="0x7f0b0478"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:minHeight="52dp"
                    android:text="0x7f14070e"
                    android:textAllCaps="false"
                    app:backgroundTint="0x7f06061d"
                    app:cornerRadius="26dp"
                    style="0x7f150448"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
