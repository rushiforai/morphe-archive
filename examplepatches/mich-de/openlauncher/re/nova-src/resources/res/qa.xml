<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="0x7f06005d"
        android:id="0x7f0b053c"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0x7f1400e8"/>
    <TextView
        android:textSize="14sp"
        android:textColor="0x7f06003f"
        android:id="0x7f0b053a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="0x7f060052"
        android:id="0x7f0b053b"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <ProgressBar
        android:id="0x7f0b053e"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progressDrawable="0x7f080184"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="12sp"
        android:textColor="0x7f060048"
        android:id="0x7f0b053f"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <Button
        android:textSize="15sp"
        android:textColor="@android:color/white"
        android:id="0x7f0b053d"
        android:background="0x7f080186"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="0x7f140109"
        android:textAllCaps="false"/>
    <Button
        android:textSize="15sp"
        android:textColor="0x7f060052"
        android:id="0x7f0b0538"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="0x7f1400e6"
        android:textAllCaps="false"/>
</LinearLayout>
