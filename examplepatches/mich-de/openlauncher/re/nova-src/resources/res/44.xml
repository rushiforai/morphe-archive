<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="400"
        android:valueFrom="0x7f140cc2"
        android:valueTo="0x7f140cc6"
        android:valueType="pathType"
        android:propertyName="pathData"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="400"
        android:valueFrom="0"
        android:valueTo="1.8"
        android:valueType="floatType"
        android:propertyName="strokeWidth"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="400"
        android:valueFrom="0"
        android:valueTo="1"
        android:valueType="floatType"
        android:propertyName="strokeAlpha"/>
    <objectAnimator
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:duration="400"
        android:valueFrom="1"
        android:valueTo="0"
        android:valueType="floatType"
        android:propertyName="fillAlpha"/>
</set>
