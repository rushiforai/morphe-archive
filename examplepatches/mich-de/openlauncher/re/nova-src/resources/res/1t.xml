<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.dragndrop.AddItemDragLayer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="0x7f0b0081"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <com.android.launcher3.widget.AddItemWidgetsBottomSheet
        android:theme="?unknown_attr_ref: 7f0406e6"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="0x7f0b007f"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="0x7f0b0080"
            android:background="0x7f08013e"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#212121"
            android:paddingVertical="24dp">
            <TextView
                android:textSize="24sp"
                android:textColor="?android:attr/textColorPrimary"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="0x7f0b0756"
                android:fadingEdge="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginHorizontal="0x7f070555"
                style="0x7f1502f2"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center_horizontal"
                android:id="0x7f0b075c"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0x7f140054"
                android:alpha="0.7"
                android:layout_marginHorizontal="0x7f070555"/>
            <ScrollView
                android:id="0x7f0b0762"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginVertical="16dp">
                <include
                    android:id="0x7f0b0758"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="0x7f070555"
                    layout="0x7f0e020c"/>
            </ScrollView>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="0x7f0b0075"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0x7f070555"
                android:paddingVertical="8dp">
                <Button
                    android:textSize="14sp"
                    android:textColor="0x7f0600c0"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@android:string/cancel"
                    android:maxLines="2"
                    android:onClick="onCancelClick"
                    android:paddingHorizontal="16dp"
                    style="0x7f15013c"/>
                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="0x7f0600c0"
                    android:ellipsize="end"
                    android:id="0x7f0b04c5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x7f14005e"
                    android:maxLines="2"
                    android:onClick="onPlaceAutomaticallyClick"
                    android:paddingHorizontal="16dp"
                    style="0x7f15013c"/>
            </LinearLayout>
        </LinearLayout>
    </com.android.launcher3.widget.AddItemWidgetsBottomSheet>
</com.android.launcher3.dragndrop.AddItemDragLayer>
