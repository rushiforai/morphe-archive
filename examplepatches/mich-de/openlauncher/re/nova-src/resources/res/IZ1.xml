<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="48dp"
    app:cardBackgroundColor="0x7f060036"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="0x7f060044"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="0x7f08016b"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="14sp"
                android:textColor="0x7f060052"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x7f140102"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <com.instabridge.ai.chat.ui.InteractiveChatTextView
            android:textSize="16sp"
            android:textColor="0x7f06003f"
            android:textColorHighlight="0x7f06005c"
            android:textColorLink="0x7f060046"
            android:id="0x7f0b0536"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="0x7f0b0158"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:alignItems="0"
            app:flexWrap="1"
            app:justifyContent="0"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="0x7f0b01d8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <EditText
                android:textSize="14sp"
                android:textColor="0x7f06003f"
                android:textColorHint="0x7f060048"
                android:id="0x7f0b01d7"
                android:background="0x7f08014b"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:hint="0x7f140107"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <ImageButton
                android:id="0x7f0b05c5"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="0x7f080171"
                android:contentDescription="0x7f1400f1"
                android:layout_marginStart="8dp"
                app:tint="0x7f06002d"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="0x7f060048"
            android:id="0x7f0b0601"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0x7f140104"/>
        <com.instabridge.ai.chat.ui.InteractiveChatTextView
            android:textSize="13sp"
            android:textColor="0x7f060052"
            android:textColorHighlight="0x7f06005c"
            android:textColorLink="0x7f060046"
            android:id="0x7f0b0184"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
