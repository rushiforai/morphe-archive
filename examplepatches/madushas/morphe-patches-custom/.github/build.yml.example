name: build

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      # The Morphe Gradle plugin resolves from GitHub Packages, which needs an
      # authenticated request. If the workflow token cannot read the MorpheApp
      # registry, add a PAT with `read:packages` as the MORPHE_TOKEN secret.
      - name: Build patch bundle
        env:
          GITHUB_ACTOR: ${{ github.actor }}
          GITHUB_TOKEN: ${{ secrets.MORPHE_TOKEN }}
        run: ./gradlew :patches:build --no-daemon

      - uses: actions/upload-artifact@v4
        with:
          name: patches-bundle
          path: patches/build/libs/*.mpp
          if-no-files-found: error
