# EditorConfig for AnghamiPlus Patches
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin sources follow the IntelliJ IDEA style, with wildcard imports allowed
# because the patch sources import several members of the same patcher objects.
[*.{kt,kts}]
ktlint_code_style = intellij_idea
ktlint_standard_no-wildcard-imports = disabled

[*.{yml,yaml,json,json5,md}]
indent_size = 2

[*.java]
indent_size = 4

# Windows launchers are the only files kept with CRLF line endings.
[*.{bat,cmd}]
end_of_line = crlf
