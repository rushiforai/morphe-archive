{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "category", "target", "assets", "dependencies", "fingerprints", "acceptance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "target": {"type": "object", "required": ["package", "versions", "launchComponent"]},
    "output": {"type": "object", "required": ["package", "label", "launchComponent"]},
    "assets": {"type": "object", "required": ["universal", "x86_64", "arm64-v8a", "armeabi-v7a"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "fingerprints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
