{
  "$schema": "../patch.schema.json",
  "id": "ratings-visibility",
  "name": "Rating Visibility",
  "category": "ratings",
  "target": {
    "application": "NuvioTV",
    "package": "com.nuvio.tv",
    "versions": ["0.8.3-beta"],
    "launchComponent": "com.nuvio.tv/.MainActivity"
  },
  "assets": {
    "universal": {
      "url": "https://github.com/NuvioMedia/NuvioTV/releases/download/0.8.3-beta/app-full-universal-release.apk",
      "sha256": "e4e2a6bb529c7f3b8a4670c9fb0a8376e919a5791d29b68e97e6e21b59f73125"
    },
    "x86_64": {
      "url": "https://github.com/NuvioMedia/NuvioTV/releases/download/0.8.3-beta/app-full-x86_64-release.apk",
      "sha256": "1c3b4cc5147c6963f70e75524622cc06195aafe6854ecf00ea96ec58551571d3"
    },
    "arm64-v8a": {
      "url": "https://github.com/NuvioMedia/NuvioTV/releases/download/0.8.3-beta/app-full-arm64-v8a-release.apk",
      "sha256": "474a45cacfb14d251240cc27f57fda30dce9eddf2aa6a198b3481365a2942785"
    },
    "armeabi-v7a": {
      "url": "https://github.com/NuvioMedia/NuvioTV/releases/download/0.8.3-beta/app-full-armeabi-v7a-release.apk",
      "sha256": "12380caf445d2e32285d184aa2a7600f8f2558af3ac96d7dda8c3f1987f47830"
    }
  },
  "dependencies": ["settings-hub"],
  "emulators": {"phone": "Pixel_10", "tv": "Television_4K"},
  "fingerprints": [
    "SettingsScreenFingerprint",
    "ExperienceSettingsHeaderFingerprint",
    "ExperienceSettingsCardFingerprint",
    "NativeSettingsSwitchUsageFingerprint",
    "MetaPreviewRatingGetterFingerprint",
    "MetaRatingGetterFingerprint",
    "ModernContinueWatchingRatingFingerprint",
    "DetailMetaInfoRatingFingerprint",
    "EpisodeCardRatingFingerprint",
    "EpisodeRatingsSectionFingerprint",
    "MetaDetailsContentFingerprint"
  ],
  "inspection": {
    "provider": "io.github.liongalahad.nuviotv.extension.settings.MorpheInitProvider",
    "metadata": "io.github.liongalahad.nuviotv.settings.provider.rating_visibility",
    "classes": [
      "io.github.liongalahad.nuviotv.extension.settings.MorpheSettingsRuntime",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheSettingsPageContent",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheSettingsRows",
      "io.github.liongalahad.nuviotv.extension.ratings.ratingsvisibility.RatingsSettingsCategory",
      "io.github.liongalahad.nuviotv.extension.ratings.ratingsvisibility.RatingsSettingsContent",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheOverallRatingsToggleAction",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheEpisodeRatingsDialogAction",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheEpisodeRatingsDialog",
      "io.github.liongalahad.nuviotv.extension.ratings.ratingsvisibility.Extension"
    ],
    "needles": [
      "ratings.overall_visibility",
      "ratings.episode_visibility",
      "Lcom/nuvio/tv/domain/model/MetaPreview;",
      "Lcom/nuvio/tv/domain/model/Video;"
    ],
    "forbiddenNeedles": ["Lcom/google/common/collect/ImmutableList;"]
  },
  "focusedTests": [
    "MorpheRatingsRuntimeTest",
    "isolated x86_64 and universal exclusive-mode application",
    "manifest and injected-class inspection"
  ],
  "acceptance": [
    "Unpatched NuvioTV has no Morphe entry",
    "Selecting only Rating Visibility shows Settings → Morphe → Ratings and no Subtitles category",
    "Ratings expands in the current pane and shows Overall Ratings and Episode Ratings",
    "Overall Ratings defaults to Show, toggles immediately, and persists after force-stop and reboot",
    "Overall Ratings Hide removes standard ratings from classic, grid, modern, hero, collection, and Detail screens",
    "Configured MDBList providers remain independent and authoritative on Detail screens",
    "Episode Ratings defaults to Show and offers Show, Hide, and Hide Unwatched in TV D-pad order",
    "Hide removes episode-card ratings and removes the Ratings tab",
    "Hide Unwatched shows ratings only for watched episodes",
    "No crash, ANR, VerifyError, or fatal log occurs during launch, settings, navigation, and playback"
  ]
}
