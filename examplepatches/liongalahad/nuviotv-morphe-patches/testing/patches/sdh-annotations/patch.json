{
  "$schema": "../patch.schema.json",
  "id": "sdh-annotations",
  "name": "Remove SDH Annotations",
  "category": "subtitles",
  "target": {
    "application": "NuvioTV",
    "package": "com.nuvio.tv",
    "versions": ["0.8.3-beta"],
    "launchComponent": "com.nuvio.tv/.MainActivity"
  },
  "assets": {
    "universal": {
      "url": "https://github.com/NuvioMedia/NuvioTV/releases/download/0.8.3-beta/app-full-universal-release.apk",
      "sha256": "e4e2a6bb529c7f3b8a4670c9fb0a8376e919a5791d29b68e97e6e21b59f73125"
    },
    "x86_64": {
      "url": "https://github.com/NuvioMedia/NuvioTV/releases/download/0.8.3-beta/app-full-x86_64-release.apk",
      "sha256": "1c3b4cc5147c6963f70e75524622cc06195aafe6854ecf00ea96ec58551571d3"
    },
    "arm64-v8a": {
      "url": "https://github.com/NuvioMedia/NuvioTV/releases/download/0.8.3-beta/app-full-arm64-v8a-release.apk",
      "sha256": "474a45cacfb14d251240cc27f57fda30dce9eddf2aa6a198b3481365a2942785"
    },
    "armeabi-v7a": {
      "url": "https://github.com/NuvioMedia/NuvioTV/releases/download/0.8.3-beta/app-full-armeabi-v7a-release.apk",
      "sha256": "12380caf445d2e32285d184aa2a7600f8f2558af3ac96d7dda8c3f1987f47830"
    }
  },
  "dependencies": ["settings-hub"],
  "emulators": {"phone": "Pixel_10", "tv": "Television_4K"},
  "fingerprints": ["SettingsScreenFingerprint", "ExperienceSettingsHeaderFingerprint", "ExperienceSettingsCardFingerprint", "NativeSettingsSwitchUsageFingerprint", "CueGroupOutputFingerprint", "LegacyCueOutputFingerprint", "SidecarCueRenderFingerprint"],
  "inspection": {
    "provider": "io.github.liongalahad.nuviotv.extension.settings.MorpheInitProvider",
    "metadata": "io.github.liongalahad.nuviotv.settings.provider.remove_sdh_annotations",
    "classes": [
      "io.github.liongalahad.nuviotv.extension.settings.MorpheSettingsRuntime",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheSettingsPageContent",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheSettingsRows",
      "io.github.liongalahad.nuviotv.extension.subtitles.sdh.RemoveSdhSettingsCategory",
      "io.github.liongalahad.nuviotv.extension.subtitles.sdh.RemoveSdhSettingsContent",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheComposeModeAction",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheSdhModeDialogAction",
      "io.github.liongalahad.nuviotv.extension.settings.MorpheSdhModeDialog",
      "io.github.liongalahad.nuviotv.extension.subtitles.sdh.SdhCleanupMode",
      "io.github.liongalahad.nuviotv.extension.subtitles.sdh.SdhCueTransformer"
    ],
    "needles": [
      "subtitles.sdh_cleanup_mode",
      "Landroidx/media3/common/text/CueGroup;"
    ],
    "forbiddenNeedles": ["Lcom/google/common/collect/ImmutableList;"]
  },
  "focusedTests": ["SdhSubtitleCleanerTest", "isolated x86_64 and universal exclusive-mode application", "manifest and injected-class inspection"],
  "acceptance": [
    "Unpatched NuvioTV has no Morphe entry",
    "Patched NuvioTV shows Settings → Morphe → Subtitles",
    "Subtitles expands in the existing pane and shows one native Remove SDH annotations selector with its current value",
    "The selector opens the same three-choice modal layout, focus treatment, typography, spacing, selected fill, checkmark, and D-pad order as Nuvio's Playback selector",
    "Exactly one of Off, Remove SDH, keep lyrics, and Full cleanup is selected in the modal",
    "Mode defaults to Off and persists after force-stop and reboot",
    "Off preserves the full subtitle text",
    "Remove SDH, keep lyrics removes annotations while preserving likely lyrics",
    "Full cleanup also removes all text enclosed by normal or supported mojibake music-note markers",
    "No crash, ANR, VerifyError, or fatal log during launch, settings, playback, seeking, or track changes"
  ]
}
