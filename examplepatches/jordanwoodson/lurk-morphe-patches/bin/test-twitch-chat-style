#!/usr/bin/env bash
# Run Chat keywords, Chat appearance and Emote and badge info on ART: Twitch's real chat line builder, chat image
# box and live message models with the emitted hooks, each setting on and off. ANDROID_SERIAL picks the device
# (default emulator-5580).
source "$(dirname "$0")/lib/common.sh"
[[ $# == 1 && -f "$1" ]] || die "usage: bash bin/test-twitch-chat-style <patched.apk>"
serial=${ANDROID_SERIAL:-emulator-5580}
out="$WORK/twitch-chat-style/art-probe"
remote=/data/local/tmp/lurk-twitch-chat-style
mkdir -p "$out/classes" "$out/dex" "$WORK/tmp"
export TMPDIR="$WORK/tmp"
android="$ANDROID_HOME/platforms/android-36/android.jar"
javac --release 17 -classpath "$android" -d "$out/classes" "$ROOT/tests/twitch/ChatStyleArtProbe.java" "$ROOT/tests/twitch/ProbeLocators.java"
"$(build_tool d8)" --min-api 29 --lib "$android" --output "$out/dex" "$out/classes/"*.class
(cd "$out/dex" && jar cf "$out/probe.jar" classes.dex)
adb -s "$serial" shell mkdir -p "$remote"
trap 'adb -s "$serial" shell rm -rf "$remote" >/dev/null 2>&1 || true' EXIT
adb -s "$serial" push "$1" "$remote/app.apk" >/dev/null
adb -s "$serial" push "$out/probe.jar" "$remote/probe.jar" >/dev/null
adb -s "$serial" shell "CLASSPATH=$remote/probe.jar:$remote/app.apk app_process /system/bin ChatStyleArtProbe $remote/app.apk"
