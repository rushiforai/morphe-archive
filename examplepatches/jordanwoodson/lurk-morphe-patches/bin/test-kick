#!/usr/bin/env bash
# Check that Kick's code calls every expected extension hook, then run the actual injected bundle loader, the
# player hooks (PlayerProbe) and the Lurk link in Linking.openURL (SettingsLinkProbe) on the scratch Android emulator.
source "$(dirname "$0")/lib/common.sh"
[[ $# == 1 && -f "$1" ]] || die "usage: bash bin/test-kick <patched.apk>"
serial=${ANDROID_SERIAL:-emulator-5580}
out="$WORK/tests/kick"
remote=/data/local/tmp/morphe-kick-test
mkdir -p "$out/classes" "$out/dex" "$WORK/tmp"
export TMPDIR="$WORK/tmp"

# The default selection's hooks (tests/kick/expected-hooks.txt): a dropped injected call fails here.
mapfile -t hooks < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$ROOT/tests/kick/expected-hooks.txt")
python3 -I "$ROOT/tests/verify_extension_calls.py" "$1" "${hooks[@]}"

javac --release 17 -classpath "$ANDROID_HOME/platforms/android-36/android.jar" \
    -d "$out/classes" "$ROOT/tests/kick/BundleProbe.java" "$ROOT/tests/kick/PlayerProbe.java" \
    "$ROOT/tests/kick/SettingsLinkProbe.java"
"$(build_tool d8)" --min-api 29 --lib "$ANDROID_HOME/platforms/android-36/android.jar" \
    --output "$out/dex" "$out/classes/"*.class
(cd "$out/dex" && jar cf "$out/probe.jar" classes.dex)
adb -s "$serial" shell mkdir -p "$remote"
trap 'adb -s "$serial" shell rm -rf "$remote" >/dev/null 2>&1 || true' EXIT
adb -s "$serial" push "$1" "$remote/app.apk" >/dev/null
adb -s "$serial" push "$out/probe.jar" "$remote/probe.jar" >/dev/null
# The stock bundle's hash is written once, in the Hermes helper.
stock=$(sed -n 's/.*const val SOURCE_SHA256 = "\([0-9a-f]\{64\}\)".*/\1/p' "$PATCHES_SRC/kick/shared/Hermes.kt")
[[ ${#stock} == 64 ]] || die "no SOURCE_SHA256 in kick/shared/Hermes.kt"
result=$(adb -s "$serial" shell "CLASSPATH=$remote/probe.jar:$remote/app.apk app_process /system/bin BundleProbe $remote/app.apk $remote/cache $stock" 2>&1)
printf '%s\n' "$result"
[[ "$result" == *"PASS: loader defaults"* && "$result" != *"Exception"* && "$result" != *"Error"* ]] ||
    die "bundle loader probe did not pass"
# A fresh process: the player probe prepares its own main Looper and settings.
result=$(adb -s "$serial" shell "CLASSPATH=$remote/probe.jar:$remote/app.apk app_process /system/bin PlayerProbe $remote/app.apk" 2>&1) ||
    true # Its output says what failed; the check below fails the run.
printf '%s\n' "$result"
[[ "$result" == *"PASS: Show video stats"* || "$result" == *"SKIP: Show video stats"* ]] &&
    [[ "$result" == *"PASS: Mute stitched live ads"* || "$result" == *"SKIP: Mute stitched live ads"* ]] &&
    [[ "$result" != *"Exception"* && "$result" != *"Error"* ]] || die "player probe did not pass"
result=$(adb -s "$serial" shell "CLASSPATH=$remote/probe.jar:$remote/app.apk app_process /system/bin SettingsLinkProbe $remote/app.apk" 2>&1) ||
    true
printf '%s\n' "$result"
[[ "$result" == *"PASS: Lurk in account menu link"* || "$result" == *"SKIP: Lurk in account menu"* ]] ||
    die "settings link probe did not pass"
