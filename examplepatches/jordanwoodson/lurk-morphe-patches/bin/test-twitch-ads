#!/usr/bin/env bash
# Execute the patched Twitch ad hooks (Block display ads, Mute stitched ads) on Android.
# The APK must include both patches. LURK_SERIAL picks the device (default emulator-5580).
source "$(dirname "$0")/lib/common.sh"
[[ $# == 1 && -f "$1" ]] || die "usage: bash bin/test-twitch-ads <patched.apk>"
serial=${ANDROID_SERIAL:-emulator-5580}
out="$WORK/twitch-ads/art-probe"
remote=/data/local/tmp/lurk-twitch-ads
mkdir -p "$out/classes" "$out/dex" "$WORK/tmp"
export TMPDIR="$WORK/tmp"
android="$ANDROID_HOME/platforms/android-36/android.jar"
# Compile-only stubs of the React Native player's display interfaces (Twitch 31.8.0's), so the probe can
# give a playback session a View display. They stay out of the DEX: the app's own interfaces load at run time.
rm -rf "$out/stub-src" "$out/stub-classes"
mkdir -p "$out/stub-src/com/twitchrn/player" "$out/stub-src/com/facebook/react/bridge" "$out/stub-classes"
cat > "$out/stub-src/com/facebook/react/bridge/ReactContext.java" <<'JAVA'
package com.facebook.react.bridge;
public class ReactContext {}
JAVA
cat > "$out/stub-src/com/twitchrn/player/PlaybackDisplay.java" <<'JAVA'
package com.twitchrn.player;
public interface PlaybackDisplay {
    boolean getSurfaceHidesUntilRevealed();
    void hideSurface();
    void onContentSize(int width, int height);
    void onSecureSurfaceRequired(boolean secure);
    void revealSurface(long fadeMs);
}
JAVA
cat > "$out/stub-src/com/twitchrn/player/PlayerHost.java" <<'JAVA'
package com.twitchrn.player;
public interface PlayerHost {
    com.facebook.react.bridge.ReactContext getReactContext();
    int getReactTag();
}
JAVA
cat > "$out/stub-src/com/twitchrn/player/PlaybackEdge.java" <<'JAVA'
package com.twitchrn.player;
public interface PlaybackEdge extends PlaybackDisplay, PlayerHost {
    interface EventListener {}
    void clearEventListener();
    void setEventListener(EventListener listener);
}
JAVA
javac --release 17 -d "$out/stub-classes" $(find "$out/stub-src" -name '*.java')
(cd "$out/stub-classes" && jar cf "$out/stubs.jar" com)
rm -rf "$out/classes"/*
javac --release 17 -classpath "$android:$out/stubs.jar" -d "$out/classes" "$ROOT/tests/twitch/AdsProbe.java" "$ROOT/tests/twitch/ProbeLocators.java"
# Only the probe enters DEX; every Twitch class and the extension come from the patched APK.
"$(build_tool d8)" --min-api 30 --lib "$android" --classpath "$out/stubs.jar" --output "$out/dex" "$out/classes/"*.class
(cd "$out/dex" && jar cf "$out/probe.jar" classes.dex)
adb -s "$serial" shell mkdir -p "$remote"
trap 'adb -s "$serial" shell rm -rf "$remote" >/dev/null 2>&1 || true' EXIT
adb -s "$serial" push "$1" "$remote/app.apk" >/dev/null
adb -s "$serial" push "$out/probe.jar" "$remote/probe.jar" >/dev/null
adb -s "$serial" shell "CLASSPATH=$remote/probe.jar:$remote/app.apk app_process /system/bin AdsProbe $remote/app.apk"
