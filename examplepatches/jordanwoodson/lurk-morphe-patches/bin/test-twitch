#!/usr/bin/env bash
# Check that every injected extension call survived patching (tests/twitch/expected-hooks.txt), then run
# the actual injected bundle loader on the scratch Android emulator.
source "$(dirname "$0")/lib/common.sh"
[[ $# == 1 && -f "$1" ]] || die "usage: bash bin/test-twitch <patched.apk>"
python3 -I "$ROOT/tests/twitch/verify_hooks.py" "$1"
serial=${ANDROID_SERIAL:-emulator-5580}
out="$WORK/tests/twitch"
remote=/data/local/tmp/morphe-twitch-test
mkdir -p "$out/classes" "$out/dex" "$WORK/tmp"
export TMPDIR="$WORK/tmp"
javac --release 17 -classpath "$ANDROID_HOME/platforms/android-36/android.jar" \
    -d "$out/classes" "$ROOT/tests/twitch/BundleProbe.java"
"$(build_tool d8)" --min-api 29 --lib "$ANDROID_HOME/platforms/android-36/android.jar" \
    --output "$out/dex" "$out/classes/"*.class
(cd "$out/dex" && jar cf "$out/probe.jar" classes.dex)
adb -s "$serial" shell mkdir -p "$remote"
trap 'adb -s "$serial" shell rm -rf "$remote" >/dev/null 2>&1 || true' EXIT
adb -s "$serial" push "$1" "$remote/app.apk" >/dev/null
adb -s "$serial" push "$out/probe.jar" "$remote/probe.jar" >/dev/null
adb -s "$serial" shell "CLASSPATH=$remote/probe.jar:$remote/app.apk app_process /system/bin BundleProbe $remote/app.apk $remote/cache"
